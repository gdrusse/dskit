    "keyed": [
      "arm"
    ]
  },
  "layout": {
    "fit": {
      "dir": "{W}/fit",
      "runs": "{W}/runs/{A}"
    }
  },
  "registry": {
    "fit": {
      "notes": "One walk-forward per arm. Its summary (walkforward.json, one score per fold) lands under the layout's `runs` directory, which select-features.json reads; the fold run directories sit beside it.",
      "template": "select-template-sequence.json",
      "extends": null,
      "command": "{python} -m dskit.pipeline walkforward {config} --asof {in.asof} --adapter {in.adapter}"
    }
  },
  "steps": {
    "fit": {
      "notes": "The as-of date is W1's end, so the run names say what the data stops at. Every value the template uses enters through `in`: the arm differs per lane, everything else is shared.",
      "registry": "fit",
      "in": {
        "A": "$lane",
        "W": "$args.work_dir",
        "asof": "$args.window.end",
        "adapter": "$args.adapter",
        "arm": "$args.arm.$lane",
        "window": "$args.window",
        "folds": "$args.folds",
        "training": "$args.training",
        "grid": "$args.grid",
        "zoo": "$args.zoo",
        "panel": "$args.panel"
      },
      "out": [
        "runs"
      ]
    }
  }
