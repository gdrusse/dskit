# Copy to .env (gitignored) and fill in — generate the pair at
# https://app.alpaca.markets → switch to Paper Trading → API Keys.
# The secret is shown ONCE at creation. Paper endpoint only; the child
# never talks to the live-money endpoint — that is hardcoded
# (TradingClient(..., paper=True)), refusal by default, so there is
# deliberately no endpoint variable here to point elsewhere.
#
# These two NAMES are the connector's key_env/secret_env defaults; both
# the puller and the forward loop read whatever the source config names,
# so rename them there (not here) to serve a second account.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
