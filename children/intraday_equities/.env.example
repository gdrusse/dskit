# Copy to .env (gitignored) and fill in. Names only — never commit values.
# Export to serve acquire as well as live.py:
#     set -a; . ./.env; set +a
#
# Alpaca: https://app.alpaca.markets → Paper Trading → API Keys.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
#
# Schwab developer app key/secret and the callback URL registered on
# the app. The token path must be an owner-only file after authorize.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=
SCHWAB_TOKEN_PATH=
