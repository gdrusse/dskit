  "splits": {
    "kind": "time",
    "train_end_ms": 1735603200000,
    "val_start_ms": 1736208000000,
    "val_end_ms": 1764288000000,
    "test_end_ms": 1772236800000,
    "notes": "Train to 2024-12-31, a one-week embargo, validation 2025-01-07 to 2025-11-28. Nothing after 2026-02-28 is read by this document."
  },
  "outputs": {
    "run_root": "",
    "notes": "Empty = ./pipeline_runs under the invoking cwd. Summary is {name}-walkforward-{asof}-{hash8}."
  },
  "tracking": {
    "sinks": [
      {
        "kind": "dskit.pipeline.libs.mlflow:MlflowTracker",
        "params": {
          "tracking_uri": "sqlite:///mlruns.db",
          "experiment": "intraday_equities"
        },
        "notes": "Local sqlite beside the invoking cwd."
      }
    ],
    "notes": "Excluded from identity \u2014 where metrics land is not what the run computes."
  }
