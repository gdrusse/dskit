{
  "name": "intraday-equities-zoo",
  "notes": "Model zoo: LSTM, GRU and TFT over the same 30-step one-minute lag window, one document, six trainers. Each architecture is fitted at two learning rates, and every trainer selects its own epoch on validation loss internally, so monitor_value is directly comparable across all six. There is no hpo-grid search node because its objective must come from a role=score node: the toolkit scorer takes contract-to-probability mappings (the banking contract) and the domain scorers read column frames, neither of which fits a torch regression on returns. Declaring the variants is the honest alternative to inventing a scorer for a comparison this small. Names JPM and XOM, both split-free. Training starts 2022-01-01; the tape floor at 2021-11-01 is warm-up only. Lockbox after 2026-02-28 is declared and unread.",
  "pipeline": {
    "universe": {
      "uses": "intraday_equities-universe",
      "params": {
        "path": "configs/universe.json"
      },
      "notes": "lead_start is the training label. One tree, five H's. Short HPO lives on the scan node, not universe.scan."
    },
    "alpaca": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip",
        "universe": "configs/universe.json"
      },
      "notes": "Historical SIP tape. root is the invoking cwd; run from the child root."
    },
    "session": {
      "uses": "filter",
      "inputs": {
        "records": "$alpaca.records"
      },
      "params": {
        "where": [
          {
            "field": "session",
            "op": "==",
            "value": "rth"
          },
          {
            "field": "asof_ms",
            "op": ">=",
            "value": 1635724800000
          }
        ]
      },
      "notes": "Regular session only, and nothing before 2021-11-01. The floor is warm-up for the widest cross-session scale, not fitting data: the split cuts start training at 2022-01-01. It also keeps the row-layout build tractable."
    },
    "features": {
      "uses": "intraday_equities-session-features",
      "inputs": {
        "records": "$session.records",
        "spec": "$universe.spec"
      },
      "params": {
        "lookback": 30,
        "layout": "rows",
        "momentum_horizons": [
          {
            "width": 3,
            "tag": "3m",
            "cross_session": false,
            "notes": "Few minutes; sharper than the 5m scale already in the 46."
          },
          {
            "width": 120,
            "tag": "2h",
            "cross_session": false,
            "notes": "Condenses the old L=120 window into ret/rv/mom."
          },
          {
            "width": 180,
            "tag": "3h",
            "cross_session": false,
            "notes": "Few hours, still inside one RTH session."
          },
          {
            "width": 780,
            "tag": "2s",
            "cross_session": true,
            "notes": "Two RTH sessions."
          },
          {
            "width": 1950,
            "tag": "1w",
            "cross_session": true,
            "notes": "Five RTH sessions \u2248 last week."
          }
        ]
      },
      "notes": "Row layout, because the torch zoo consumes records rather than frames. lookback=30 emits ret_lag_0..29, which IS the sequence the zoo reads: seq_len 30 x channels 1."
    },
    "tradable": {
      "uses": "intraday_equities-keep-symbols",
      "inputs": {
        "records": "$features.records",
        "symbols": "$universe.tradable"
      },
      "params": {
        "field": "symbol"
      },
      "notes": "Score tradable names only. SPY already entered residuals. One tree; each name still walks its own H."
    },
    "pair": {
      "uses": "filter",
      "inputs": {
        "records": "$tradable.records"
      },
      "params": {
        "where": [
          {
            "field": "symbol",
            "op": "in",
            "value": [
              "JPM",
              "XOM"
            ]
          }
        ]
      },
      "notes": "JPM and XOM only. Both are split-free across the whole 2016-2026 tape, so the unadjusted-split contamination cannot reach any fold. Sits after tradable so the six-symbol cohort that built the features is untouched."
    },
    "train_rows": {
      "uses": "intraday_equities-lead-labels",
      "inputs": {
        "records": "$pair.records",
        "bars": "$features.tape",
        "spec": "$universe.spec"
      },
      "params": {
        "lead": 5,
        "split": "train",
        "train_end_ms": 1735603200000,
        "val_start_ms": 1736208000000,
        "val_end_ms": 1764288000000,
        "label": "y_next"
      },
      "notes": "train rows carrying the 5-minute forward log return as y_next, on the same tape arithmetic the scan node uses."
    },
    "val_rows": {
      "uses": "intraday_equities-lead-labels",
      "inputs": {
        "records": "$pair.records",
        "bars": "$features.tape",
        "spec": "$universe.spec"
      },
      "params": {
        "lead": 5,
        "split": "val",
        "train_end_ms": 1735603200000,
        "val_start_ms": 1736208000000,
        "val_end_ms": 1764288000000,
        "label": "y_next"
      },
      "notes": "val rows carrying the 5-minute forward log return as y_next, on the same tape arithmetic the scan node uses."
    },
    "lstm_lr0": {
      "uses": "torch-ts-train",
      "mode": "train",
      "inputs": {
        "rows": "$train_rows.records",
        "val_rows": "$val_rows.records"
      },
      "params": {
        "arch": "lstm",
        "head": "regression",
        "seq_len": 30,
        "channels": 1,
        "order": "recent_first",
        "arch_params": {
          "lstm": {
            "hidden_size": 32,
            "num_layers": 1
          }
        },
        "features": [
          "ret_lag_0",
          "ret_lag_1",
          "ret_lag_2",
          "ret_lag_3",
          "ret_lag_4",
          "ret_lag_5",
          "ret_lag_6",
          "ret_lag_7",
          "ret_lag_8",
          "ret_lag_9",
          "ret_lag_10",
          "ret_lag_11",
          "ret_lag_12",
          "ret_lag_13",
          "ret_lag_14",
          "ret_lag_15",
          "ret_lag_16",
          "ret_lag_17",
          "ret_lag_18",
          "ret_lag_19",
          "ret_lag_20",
          "ret_lag_21",
          "ret_lag_22",
          "ret_lag_23",
          "ret_lag_24",
          "ret_lag_25",
          "ret_lag_26",
          "ret_lag_27",
          "ret_lag_28",
          "ret_lag_29"
        ],
        "label": "y_next",
        "optimizer": "torch.optim:Adam",
        "optimizer_params": {
          "weight_decay": 0.0
        },
        "epochs": 8,
        "lr": 0.001,
        "loader": {
          "batch_size": 512,
          "shuffle": true,
          "seed": 7
        },
        "device": "cuda",
        "monitor": "val_loss"
      },
      "notes": "LSTM at lr=0.001. seq_len 30 x channels 1 over ret_lag_0..29. Compare on metrics.monitor_value (validation loss at the selected epoch); lower is better."
    },
    "lstm_lr1": {
      "uses": "torch-ts-train",
      "mode": "train",
      "inputs": {
