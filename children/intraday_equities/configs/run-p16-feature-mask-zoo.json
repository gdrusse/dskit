    "memory": {
      "uses": "intraday_equities.modelability_study:MemoryPreflightStage",
      "params": {
        "memory_limit_bytes": 18253611008,
        "groups": {
          "a": {
            "universe": "configs/universe-p12-a.json",
            "sources": [
              "source_a"
            ]
          },
          "c": {
            "universe": "configs/universe-p12-c.json",
            "sources": [
              "source_a",
              "source_c"
            ]
          },
          "d": {
            "universe": "configs/universe-p13-d-selected.json",
            "sources": [
              "source_a",
              "source_d"
            ]
          },
          "e": {
            "universe": "configs/universe-p13-e-selected.json",
            "sources": [
              "source_a",
              "source_e"
            ]
          }
        }
      },
      "notes": "Build four bounded P13 group caches containing the frozen P12 feature matrix, label tape, and causal five-minute OHLCVA bars. The P12 caches remain untouched because write-once cache identity changes when K-lines are added. Groups D and E use P13 cohort-only universes plus SPY so unused P12 breadth candidates cannot inflate peak memory."
    },
    "materialize": {
      "uses": "intraday_equities.model_zoo:PooledGate3ZooCandidates",
      "inputs": {
        "preflight": "$memory.passed",
        "caches": "$memory.groups"
      },
      "params": {
        "gate3_artifact": "../pipeline_runs/p12-g3-recovery-staged-2026-02-28-a1f293a2/stages/gate3_recovery.json",
        "gate3_sha256": "098b21eaef6ee0260753d4f981ca2337bccae406b9efd394284d9b180ba03bd0",
        "cache_groups": [
          "a",
          "c",
          "d",
          "e"
        ],
        "templates": [
          {
            "id": "full",
            "family": "pooled-lightgbm",
            "representation": "pooled-tabular-native-category",
            "feature_policy": "all frozen P12 features; symbol_code is native categorical (control, no mask)",
            "feature_source": "tabular",
            "seed_policy": "fixed seed 0 with purged inner HPO",
            "compute_class": "cpu-medium",
            "compute_rank": 1,
