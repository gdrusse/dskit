{
  "name": "p16-feature-mask-zoo",
  "notes": "ADR-0108 (docs/architecture/decision-log.md): a fixed family-mask ablation over the P13 pooled LightGBM winner. Same sources, universe, memory stage, PooledGate3ZooCandidates materialization and 20-fold development walkforward as run-p13-pooled-model-zoo.json; the five candidates below (full/short-lags/core-scales/no-cal-tail/lean) share one estimator family and one hpo_space and differ ONLY in the column mask ColumnSubsetEstimator.drop carries in estimator_params — pipeline.features_* stays byte-identical across every candidate, so the benchmark contract keeps proving the rows were the same. Plan-only until the owner approves the exact inventory (see stages.approval).",
  "pipeline": {
    "universe": {
      "uses": "intraday_equities-universe",
      "params": {
        "path": "configs/universe-p13-pooled.json"
      }
    },
    "source_a": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip-split",
        "universe": "configs/universe-p13-pooled.json",
        "start_ms": 1514764800000,
        "sessions": [
          "rth"
        ],
        "shared_fields": [
          "symbol",
          "ts"
        ]
      },
      "notes": "alpaca-sip-split holds eleven P10 names and SPY; SPY is the reference every group build reads from this source under its own group universe bound."
    },
    "source_c": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip-split-c",
        "universe": "configs/universe-p13-pooled.json",
        "start_ms": 1514764800000,
        "sessions": [
          "rth"
        ],
        "shared_fields": [
          "symbol",
          "ts"
        ]
      }
    },
    "source_d": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip-split-d",
        "universe": "configs/universe-p13-pooled.json",
        "start_ms": 1514764800000,
        "sessions": [
          "rth"
        ],
        "shared_fields": [
          "symbol",
          "ts"
        ]
      }
    },
    "source_e": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip-split-e",
        "universe": "configs/universe-p13-pooled.json",
        "start_ms": 1514764800000,
        "sessions": [
          "rth"
        ],
        "shared_fields": [
          "symbol",
          "ts"
        ]
      }
    },
    "pooled": {
      "uses": "concat",
      "inputs": {
        "a": "$source_a.records",
        "c": "$source_c.records",
        "d": "$source_d.records",
        "e": "$source_e.records"
      },
      "params": {
        "shape": "records",
        "provenance_waiver": "Each immutable MarketRecord already carries its source; the five symbol namespaces are disjoint and checked below.",
        "key": "symbol",
        "consume_inputs": true
      },
      "notes": "Only source groups containing the 25 selected names are read; their symbol namespaces are disjoint and source_a also supplies SPY."
    },
    "features": {
      "uses": "intraday_equities-session-features",
      "inputs": {
        "records": "$pooled.merged",
        "spec": "$universe.spec"
      },
      "params": {
        "lookback": 20,
        "layout": "columns",
        "dtype": "float32",
        "include_klines": true,
        "cache_dir": "./pipeline_cache/p13-features-f32-kronos-v1",
        "momentum_horizons": [
          {
            "width": 3,
            "tag": "3m",
            "cross_session": false
          },
          {
            "width": 120,
            "tag": "2h",
            "cross_session": true
          },
          {
            "width": 180,
            "tag": "3h",
            "cross_session": true
          },
          {
            "width": 780,
            "tag": "2s",
            "cross_session": true
          },
          {
            "width": 1950,
            "tag": "1w",
            "cross_session": true
          }
        ]
      }
    },
    "scan": {
      "uses": "intraday_equities-no-information-scan",
      "inputs": {
        "records": "$features.records",
        "bars": "$features.tape",
        "spec": "$universe.spec"
      },
      "params": {
        "split": "val",
        "train_end_ms": "$splits.train_end_ms",
        "train_start_ms": "$splits.train_start_ms",
        "val_start_ms": "$splits.val_start_ms",
        "val_end_ms": "$splits.val_end_ms",
        "label_scale": "vol",
        "label_residual": "SPY",
        "label_residual_self": "raw",
        "fit_symbols": [
          "LLY",
          "QQQ",
          "XLF",
          "XLE",
          "XLK",
          "BAC",
          "SMH",
          "IWM",
          "XBI",
          "FCX",
          "DAL",
          "NRG",
          "MET",
          "MSTR",
          "NOW",
          "LULU",
          "PANW",
          "INTC",
          "CIEN",
          "LRCX",
          "TER",
          "BIDU",
          "LITE",
          "ADBE",
          "ANET"
        ],
        "lead_start": 1,
        "lead_step": 1,
        "lead_stop": 1,
        "score_period_ms": 1800000,
        "estimator": "lightgbm.LGBMRegressor",
        "estimator_params": {
          "n_estimators": 800,
          "learning_rate": 0.005,
          "num_leaves": 4,
          "max_depth": 2,
          "min_child_samples": 2000,
          "reg_lambda": 100.0,
          "reg_alpha": 0.1,
          "subsample": 0.5,
          "subsample_freq": 1,
          "colsample_bytree": 0.3,
          "n_jobs": 8,
          "random_state": 0,
          "verbosity": -1
        },
        "score_symbols": [
          "LLY",
          "QQQ",
          "XLF",
          "XLE",
          "XLK",
          "BAC",
          "SMH",
          "IWM",
          "XBI",
          "FCX",
          "DAL",
          "NRG",
          "MET",
          "MSTR",
          "NOW",
          "LULU",
          "PANW",
          "INTC",
          "CIEN",
          "LRCX",
          "TER",
          "BIDU",
          "LITE",
          "ADBE",
          "ANET"
        ]
      }
    }
  },
  "walkforward": {
    "objective": "$scan.metrics.val_ic",
    "select": "max",
    "first": "2022-05-06",
    "step_days": 63,
    "count": 20,
    "val_days": 63,
    "embargo_days": 5,
    "train_days": 730
  },
  "tracking": {
    "sinks": [
      {
        "kind": "dskit.pipeline.libs.mlflow:MlflowTracker",
        "params": {
          "tracking_uri": "sqlite:///mlruns.db",
          "experiment": "intraday_equities"
        },
        "notes": "Local sqlite beside the invoking cwd."
      }
    ],
    "notes": "Excluded from identity - where metrics land is not what it computes."
  },
  "outputs": {
    "run_root": "./pipeline_runs"
  },
  "stages": {
    "calendar": {
      "uses": "dskit.pipeline.program_calendar:ProgramCalendar",
