                  2000
                ],
                "reg_lambda": [
                  10.0,
                  100.0,
                  1000.0
                ],
                "reg_alpha": [
                  0.0,
                  0.1,
                  1.0
                ],
                "colsample_bytree": [
                  0.3,
                  0.5,
                  0.7
                ]
              }
            }
          },
          {
            "id": "short-lags",
            "family": "pooled-lightgbm",
            "representation": "pooled-tabular-native-category",
            "feature_policy": "all frozen P12 features except ret_lag_5..19 (the 15 oldest one-minute return lags); symbol_code is native categorical",
            "feature_source": "tabular",
            "seed_policy": "fixed seed 0 with purged inner HPO",
