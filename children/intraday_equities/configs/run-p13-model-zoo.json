    "plan": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkPlan",
      "inputs": {
        "phase": "$calendar.phase",
        "calendar_sha256": "$calendar.calendar_sha256",
        "candidates": "$materialize.candidates"
      },
      "params": {
        "protocol": {
          "attempt_family": "intraday-equities-p13-gate3-model-zoo",
          "primary_score": "paired outer-fold validation IC per Gate-3-approved asset-horizon pair",
          "null_baseline": "Gate-3 LightGBM incumbent plus canonical train-only-selected ridge control",
          "cost_model": "equal Gate-3 asset-horizon weight; fixed compute-class tables and declared compute frontier",
          "lockbox": "no candidate may read at or after 2026-03-01",
          "decision_rule": "per pair choose the lowest-compute candidate whose deficit from the observed best is not family-wise detectable; this is a heuristic, not an equivalence claim; aggregate families by equal pair weight; never auto-promote",
          "alpha": 0.05,
          "comparison_hac_lags": 1,
          "multiplicity_method": "bonferroni_all_pairwise",
          "indifference_method": "paired_fold_newey_west_no_detectable_difference"
        },
        "contract_paths": [
          "pipeline.universe.uses",
          "pipeline.universe.params.path",
          "pipeline.features.uses",
          "pipeline.features.params.path",
          "pipeline.features.params.manifest_sha256",
          "pipeline.asset_features.uses",
          "pipeline.asset_features.inputs.records",
          "pipeline.asset_features.params.where",
          "pipeline.reference_tape.uses",
          "pipeline.reference_tape.inputs.records",
          "pipeline.reference_tape.params.where",
          "pipeline.scan.uses",
          "pipeline.scan.inputs.records",
          "pipeline.scan.inputs.bars",
          "pipeline.scan.inputs.spec",
          "pipeline.scan.params.split",
          "pipeline.scan.params.label_scale",
          "pipeline.scan.params.label_residual",
          "pipeline.scan.params.label_residual_self",
          "pipeline.scan.params.fit_symbols",
          "pipeline.scan.params.score_symbols",
          "pipeline.scan.params.lead_start",
          "pipeline.scan.params.lead_step",
          "pipeline.scan.params.lead_stop",
          "pipeline.scan.params.score_period_ms",
          "walkforward.objective",
          "walkforward.select",
          "walkforward.first",
          "walkforward.step_days",
          "walkforward.count",
          "walkforward.val_days",
          "walkforward.embargo_days",
          "walkforward.train_days"
        ]
      }
    },
    "approval": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkApproval",
      "inputs": {
        "inventory_sha256": "$plan.inventory_sha256"
      },
      "params": {
        "approved_inventory_sha256": "PENDING-PLAN-REVIEW",
        "approved_by": "PENDING-PLAN-REVIEW",
        "approval_note": "First invocation is plan-only. Review the frozen inventory, then replace both PENDING values before any candidate may fit."
      }
    },
    "run": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkRun",
      "inputs": {
