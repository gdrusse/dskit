{
  "name": "p17-randomforest-zoo",
  "notes": "P17 paired pooled tabular zoo: a RandomForestRegressor candidate (native max_features feature selection; symbol_code kept as a numeric code the forest can split on) alongside the re-run P13 LightGBM frontier as its paired baseline. Each family owns train-only HPO. This is the tabular-side complement to the sequence-side P16 TFT run; both feed the cross-zoo descriptive reference.",
  "pipeline": {
    "universe": {
      "uses": "intraday_equities-universe",
      "params": {
        "path": "configs/universe-p13-pooled.json"
      }
    },
    "source_a": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip-split",
        "universe": "configs/universe-p13-pooled.json",
        "start_ms": 1514764800000,
        "sessions": [
          "rth"
        ],
        "shared_fields": [
          "symbol",
          "ts"
        ]
      },
      "notes": "alpaca-sip-split holds eleven P10 names and SPY; SPY is the reference every group build reads from this source under its own group universe bound."
    },
    "source_c": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip-split-c",
        "universe": "configs/universe-p13-pooled.json",
        "start_ms": 1514764800000,
        "sessions": [
          "rth"
        ],
        "shared_fields": [
          "symbol",
          "ts"
        ]
      }
    },
    "source_d": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip-split-d",
        "universe": "configs/universe-p13-pooled.json",
        "start_ms": 1514764800000,
        "sessions": [
          "rth"
        ],
        "shared_fields": [
          "symbol",
          "ts"
        ]
      }
    },
    "source_e": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip-split-e",
        "universe": "configs/universe-p13-pooled.json",
        "start_ms": 1514764800000,
        "sessions": [
          "rth"
        ],
        "shared_fields": [
          "symbol",
          "ts"
        ]
      }
    },
    "pooled": {
      "uses": "concat",
      "inputs": {
        "a": "$source_a.records",
        "c": "$source_c.records",
        "d": "$source_d.records",
        "e": "$source_e.records"
      },
      "params": {
        "shape": "records",
        "provenance_waiver": "Each immutable MarketRecord already carries its source; the five symbol namespaces are disjoint and checked below.",
        "key": "symbol",
        "consume_inputs": true
      },
      "notes": "Only source groups containing the 25 selected names are read; their symbol namespaces are disjoint and source_a also supplies SPY."
    },
    "features": {
      "uses": "intraday_equities-session-features",
      "inputs": {
        "records": "$pooled.merged",
        "spec": "$universe.spec"
      },
      "params": {
        "lookback": 20,
        "layout": "columns",
        "dtype": "float32",
        "include_klines": true,
        "cache_dir": "./pipeline_cache/p13-features-f32-kronos-v1",
        "momentum_horizons": [
          {
            "width": 3,
            "tag": "3m",
            "cross_session": false
          },
          {
            "width": 120,
            "tag": "2h",
            "cross_session": true
          },
          {
            "width": 180,
            "tag": "3h",
            "cross_session": true
          },
          {
            "width": 780,
            "tag": "2s",
            "cross_session": true
          },
          {
            "width": 1950,
            "tag": "1w",
            "cross_session": true
          }
        ]
      }
    },
    "scan": {
      "uses": "intraday_equities-no-information-scan",
      "inputs": {
        "records": "$features.records",
        "bars": "$features.tape",
        "spec": "$universe.spec"
      },
      "params": {
        "split": "val",
        "train_end_ms": "$splits.train_end_ms",
        "train_start_ms": "$splits.train_start_ms",
        "val_start_ms": "$splits.val_start_ms",
        "val_end_ms": "$splits.val_end_ms",
        "label_scale": "vol",
        "label_residual": "SPY",
        "label_residual_self": "raw",
        "fit_symbols": [
          "LLY",
          "QQQ",
          "XLF",
          "XLE",
          "XLK",
          "BAC",
          "SMH",
          "IWM",
          "XBI",
          "FCX",
          "DAL",
          "NRG",
          "MET",
          "MSTR",
          "NOW",
          "LULU",
          "PANW",
          "INTC",
          "CIEN",
          "LRCX",
          "TER",
          "BIDU",
          "LITE",
          "ADBE",
          "ANET"
        ],
        "lead_start": 1,
        "lead_step": 1,
        "lead_stop": 1,
        "score_period_ms": 1800000,
        "estimator": "lightgbm.LGBMRegressor",
        "estimator_params": {
          "n_estimators": 800,
          "learning_rate": 0.005,
          "num_leaves": 4,
          "max_depth": 2,
          "min_child_samples": 2000,
          "reg_lambda": 100.0,
          "reg_alpha": 0.1,
          "subsample": 0.5,
          "subsample_freq": 1,
          "colsample_bytree": 0.3,
          "n_jobs": 8,
          "random_state": 0,
          "verbosity": -1
        },
        "score_symbols": [
          "LLY",
          "QQQ",
          "XLF",
          "XLE",
          "XLK",
          "BAC",
          "SMH",
          "IWM",
          "XBI",
          "FCX",
          "DAL",
          "NRG",
          "MET",
          "MSTR",
          "NOW",
          "LULU",
          "PANW",
          "INTC",
          "CIEN",
          "LRCX",
          "TER",
          "BIDU",
          "LITE",
          "ADBE",
          "ANET"
        ]
      }
    }
  },
  "walkforward": {
    "objective": "$scan.metrics.val_ic",
    "select": "max",
    "first": "2022-05-06",
    "step_days": 63,
    "count": 20,
    "val_days": 63,
    "embargo_days": 5,
    "train_days": 730
  },
  "tracking": {
    "sinks": [
      {
        "kind": "dskit.pipeline.libs.mlflow:MlflowTracker",
        "params": {
          "tracking_uri": "sqlite:///mlruns.db",
          "experiment": "intraday_equities"
        },
        "notes": "Local sqlite beside the invoking cwd."
      }
    ],
    "notes": "Excluded from identity - where metrics land is not what it computes."
  },
  "outputs": {
    "run_root": "./pipeline_runs"
  },
  "stages": {
    "calendar": {
      "uses": "dskit.pipeline.program_calendar:ProgramCalendar",
      "params": {
        "path": "program-calendar-p13-model-zoo.json",
        "phase": "model_zoo"
      }
    },
    "memory": {
      "uses": "intraday_equities.modelability_study:MemoryPreflightStage",
      "params": {
        "memory_limit_bytes": 18253611008,
        "groups": {
          "a": {
            "universe": "configs/universe-p12-a.json",
            "sources": [
              "source_a"
            ]
          },
          "c": {
            "universe": "configs/universe-p12-c.json",
            "sources": [
              "source_a",
              "source_c"
            ]
          },
          "d": {
            "universe": "configs/universe-p13-d-selected.json",
            "sources": [
              "source_a",
              "source_d"
            ]
          },
          "e": {
            "universe": "configs/universe-p13-e-selected.json",
            "sources": [
              "source_a",
              "source_e"
            ]
          }
        }
      },
      "notes": "Verify and reuse the four bounded P13 group caches containing the frozen P12 feature matrix, label tape, and causal five-minute OHLCVA bars. Groups D and E use P13 cohort-only universes plus SPY."
    },
    "materialize": {
      "uses": "intraday_equities.model_zoo:PooledGate3ZooCandidates",
      "inputs": {
        "preflight": "$memory.passed",
        "caches": "$memory.groups"
      },
      "params": {
        "gate3_artifact": "../pipeline_runs/p12-g3-recovery-staged-2026-02-28-a1f293a2/stages/gate3_recovery.json",
        "gate3_sha256": "098b21eaef6ee0260753d4f981ca2337bccae406b9efd394284d9b180ba03bd0",
        "cache_groups": [
          "a",
          "c",
          "d",
          "e"
        ],
        "templates": [
          {
            "id": "lgbm-p17",
            "family": "pooled-lightgbm",
            "representation": "pooled-tabular-native-category",
            "feature_policy": "all frozen P12 features; symbol_code is native categorical",
            "feature_source": "tabular",
            "seed_policy": "fixed seed 0 with purged inner HPO",
            "compute_class": "cpu-medium",
            "compute_rank": 1,
            "enabled": true,
            "model": {
              "estimator": "lightgbm.LGBMRegressor",
              "estimator_params": {
                "n_estimators": 600,
                "learning_rate": 0.01,
                "num_leaves": 8,
                "max_depth": 3,
                "min_child_samples": 1000,
                "reg_lambda": 100.0,
                "reg_alpha": 0.1,
                "subsample": 0.7,
                "subsample_freq": 1,
                "colsample_bytree": 0.5,
                "n_jobs": 8,
                "random_state": 0,
                "verbosity": -1
              },
              "hpo_trials": 4,
              "hpo_seed": 0,
              "hpo_val_days": 63,
              "hpo_embargo_days": 5,
              "hpo_objective": "ic",
              "hpo_space": {
                "num_leaves": [
                  4,
                  8,
                  16
                ],
                "max_depth": [
                  2,
                  3,
                  4
                ],
                "min_child_samples": [
                  500,
                  1000,
                  2000
                ],
                "reg_lambda": [
                  10.0,
                  100.0,
                  1000.0
                ],
                "reg_alpha": [
                  0.0,
                  0.1,
                  1.0
                ],
                "colsample_bytree": [
                  0.3,
                  0.5,
                  0.7
                ]
              }
            }
          },
          {
            "id": "rf",
            "family": "pooled-randomforest",
            "representation": "pooled-tabular-native-category-code",
            "feature_policy": "all frozen P12 features; symbol_code is a numeric code the forest splits on; feature selection is RF-native max_features",
            "feature_source": "tabular",
            "seed_policy": "fixed seed 0 with purged inner HPO",
            "compute_class": "cpu-large",
            "compute_rank": 2,
            "enabled": true,
            "model": {
              "estimator": "sklearn.ensemble.RandomForestRegressor",
              "estimator_params": {
                "n_estimators": 200,
                "max_depth": 6,
                "min_samples_leaf": 500,
                "max_features": 0.3,
                "n_jobs": 8,
                "random_state": 0
              },
              "hpo_trials": 3,
              "hpo_seed": 0,
              "hpo_val_days": 63,
              "hpo_embargo_days": 5,
              "hpo_objective": "ic",
              "hpo_space": {
                "n_estimators": [
                  100,
                  200,
                  300
                ],
                "max_depth": [
                  4,
                  6,
                  8
                ],
                "min_samples_leaf": [
                  200,
                  500,
                  1000
                ],
                "max_features": [
                  0.15,
                  0.3,
                  0.5,
                  0.75
                ]
              }
            }
          }
        ],
        "path_protocol": {
          "forecast_strategy": "direct_per_lead",
          "horizon_weighting": "equal_asset_equal_within_asset",
          "fit_universe": "all_gate3_passers_each_lead",
          "score_universe": "certified_horizon_includes_lead"
        }
      }
    },
    "plan": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkPlan",
      "inputs": {
        "phase": "$calendar.phase",
        "calendar_sha256": "$calendar.calendar_sha256",
        "candidates": "$materialize.candidates"
      },
      "params": {
        "protocol": {
          "attempt_family": "intraday-equities-p17-randomforest-zoo",
          "primary_score": "equal-stock and equal-within-stock mean train-scaled squared-error improvement over each stock's train-only mean",
          "null_baseline": "per-stock train-only no-information mean",
          "cost_model": "one pooled direct fit per lead and fold; declared compute ranks",
          "lockbox": "no candidate may read at or after 2026-03-01",
          "decision_rule": "compare paired outer-fold path scores; report only, never auto-promote",
          "alpha": 0.05,
          "comparison_hac_lags": 1,
          "multiplicity_method": "bonferroni_all_pairwise",
          "indifference_method": "paired_fold_newey_west_no_detectable_difference"
        },
        "contract_paths": [
          "pipeline.universe",
          "pipeline.features_a",
          "pipeline.features_c",
          "pipeline.features_d",
          "pipeline.features_e",
          "pipeline.pooled_features_a",
          "pipeline.pooled_features_c",
          "pipeline.pooled_features_d",
          "pipeline.pooled_features_e",
          "pipeline.pooled_tape_a",
          "pipeline.pooled_tape_c",
          "pipeline.pooled_tape_d",
          "pipeline.pooled_tape_e",
          "pipeline.pooled_features",
          "pipeline.reference_tape",
          "pipeline.scan_h01.uses",
          "pipeline.scan_h01.inputs.bars",
          "pipeline.scan_h01.inputs.spec",
          "pipeline.scan_h01.params.split",
          "pipeline.scan_h01.params.label_scale",
          "pipeline.scan_h01.params.label_residual",
          "pipeline.scan_h01.params.label_residual_self",
          "pipeline.scan_h01.params.fit_symbols",
          "pipeline.scan_h01.params.score_symbols",
          "pipeline.scan_h01.params.lead_start",
          "pipeline.scan_h01.params.lead_step",
          "pipeline.scan_h01.params.lead_stop",
          "pipeline.scan_h01.params.score_period_ms",
          "pipeline.scan_h01.params.common_lead_stop",
          "pipeline.scan_h01.params.common_origin_policy",
          "pipeline.path.uses",
          "pipeline.path.params.split",
          "pipeline.path.params.asset_horizons",
          "pipeline.path.params.horizon_weighting",
          "pipeline.path.params.score",
          "walkforward.objective",
          "walkforward.select",
          "walkforward.first",
          "walkforward.step_days",
          "walkforward.count",
          "walkforward.val_days",
          "walkforward.embargo_days",
          "walkforward.train_days"
        ]
      }
    },
    "approval": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkApproval",
      "inputs": {
        "inventory_sha256": "$plan.inventory_sha256"
      },
      "params": {
        "approved_inventory_sha256": "c97fb8d47dfd88e84495e1a457a0adf93c8d5b3a7c1caf55da0263b3c47ce081",
        "approved_by": "owner",
        "approval_note": "Owner approved this exact two-candidate tabular inventory on 2026-09-07: a trimmed pooled RandomForest (three purged inner HPO trials, n_estimators up to 300) paired against the P13 LightGBM frontier."
      }
    },
    "run": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkRun",
      "inputs": {
        "candidates": "$plan.candidates",
        "approval": "$approval.approval"
      }
    },
    "compare": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkCompare",
      "inputs": {
        "runs": "$run.runs",
        "protocol": "$plan.protocol",
        "contracts": "$plan.contracts",
        "approval": "$approval.approval"
      }
    }
  }
}