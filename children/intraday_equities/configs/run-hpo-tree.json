{
  "name": "intraday-equities-hpo-tree",
  "notes": "40 TPE trials over histogram gradient boosting on the frozen HPO slice.",
  "pipeline": {
    "universe": {
      "uses": "intraday_equities-universe",
      "params": {
        "path": "configs/universe.json"
      },
      "notes": "The only market and science knob file. Add a candidate by editing this file plus the source configs; run documents do not restate names."
    },
    "alpaca": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip",
        "universe": "configs/universe.json"
      },
      "notes": "Historical SIP tape. root is the invoking cwd; run from the child root."
    },
    "session": {
      "uses": "filter",
      "inputs": {
        "records": "$alpaca.records"
      },
      "params": {
        "where": [
          {
            "field": "session",
            "op": "==",
            "value": "rth"
          }
        ]
      },
      "notes": "Research uses regular-session rows; the store still keeps every vendor minute."
    },
    "window": {
      "uses": "intraday_equities-window",
      "inputs": {
        "records": "$session.records"
      },
      "params": {
        "lookback": "$universe.lookback",
        "label_lead": 1,
        "max_gap_minutes": "$universe.max_gap_minutes"
      },
      "notes": "Elapsed-minute log-return windows. Horizon is this document's only modelling difference besides the grid."
    },
    "grid": {
      "uses": "event-grid",
      "inputs": {
        "records": "$window.records"
      },
      "params": {
        "period_ms": 60000,
        "offset_ms": 0
      },
      "notes": "Action cadence. First pass equals the label horizon; decoupling needs a new document."
    },
    "tradable": {
      "uses": "intraday_equities-keep-symbols",
      "inputs": {
        "records": "$grid.records",
        "symbols": "$universe.tradable"
      },
      "params": {
        "field": "symbol"
      },
      "notes": "Allow-list is $universe.tradable. Reference names stay on the tape for features and never land here."
    },
    "train_rows": {
      "uses": "filter",
      "inputs": {
        "records": "$tradable.records"
      },
      "params": {
        "where": [
          {
            "field": "asof_ms",
            "op": "<=",
            "value": "$splits.train_end_ms"
          }
        ]
      },
      "notes": "Fit stops at the chronological cut; the lockbox is never here."
    },
    "val_rows": {
      "uses": "filter",
      "inputs": {
        "records": "$tradable.records"
      },
      "params": {
        "where": [
          {
            "field": "asof_ms",
            "op": ">=",
            "value": "$splits.val_start_ms"
          },
          {
            "field": "asof_ms",
            "op": "<=",
            "value": "$splits.val_end_ms"
          }
        ]
      },
      "notes": "Selection window after the embargo, before the lockbox."
    },
    "qhat": {
      "uses": "dskit.pipeline.libs.sklearn:SklearnFit",
      "mode": "train",
      "inputs": {
        "rows": "$train_rows.records"
      },
      "params": {
        "estimator": "sklearn.ensemble.HistGradientBoostingRegressor",
        "estimator_params": {
          "max_depth": 6,
          "learning_rate": 0.1
        },
        "features": [
          "ret_lag_0",
          "ret_lag_1",
          "ret_lag_2",
          "ret_lag_3",
          "ret_lag_4",
          "ret_lag_5",
          "ret_lag_6",
          "ret_lag_7",
          "ret_lag_8",
          "ret_lag_9",
          "ret_lag_10",
          "ret_lag_11",
          "ret_lag_12",
          "ret_lag_13",
          "ret_lag_14",
          "ret_lag_15",
          "ret_lag_16",
          "ret_lag_17",
          "ret_lag_18",
          "ret_lag_19",
          "ret_lag_20",
          "ret_lag_21",
          "ret_lag_22",
          "ret_lag_23",
          "ret_lag_24",
          "ret_lag_25",
          "ret_lag_26",
          "ret_lag_27",
          "ret_lag_28",
          "ret_lag_29"
        ],
        "label": "y_next",
        "seed": 7
      },
      "notes": "Family under search; winner is materialized later in run-model-compare.json."
    },
    "select": {
      "uses": "intraday_equities-portfolio",
      "inputs": {
        "signal": "$qhat.signal",
        "records": "$val_rows.records",
        "labeled": "$val_rows.records",
        "tradable": "$universe.tradable"
      },
      "params": {
        "split": "val"
      },
      "notes": "One name among the five tradable names; paper fills come later."
    },
    "search": {
      "uses": "dskit.pipeline.libs.optuna:OptunaSearch",
      "params": {
        "space": {
          "qhat.estimator_params.max_depth": [
            3,
            6,
            9
          ]
        },
        "objective": "$select.metrics.rank_ic",
        "n_trials": 40,
        "seed": 0,
        "direction": "maximize"
      },
      "notes": "Reduced-data family search. Objective is Spearman IC of predicted vs y_next on val rows \u2014 n_picks is a cadence count, not model quality."
    }
  },
  "splits": {
    "kind": "time",
    "train_end_ms": 1764547199000,
    "val_start_ms": 1764633600000,
    "val_end_ms": 1772323199000,
    "test_end_ms": 1788134399000,
    "notes": "Chronological cuts with a one-day embargo. The latest six months are the lockbox (test); action-window selection and HPO stop at val_end."
  },
  "outputs": {
    "run_root": ""
  },
  "tracking": {
    "sinks": [
      {
        "kind": "dskit.pipeline.libs.mlflow:MlflowTracker",
        "params": {
          "tracking_uri": "sqlite:///mlruns.db",
          "experiment": "intraday_equities"
        },
        "notes": "Local sqlite beside the invoking cwd. One experiment so cadence and HPO runs compare in one UI. Params are the declared document; metrics are the final pass. Trials do not reach this sink."
      }
    ],
    "notes": "Excluded from identity \u2014 where metrics land is not what the run computes."
  }
}
