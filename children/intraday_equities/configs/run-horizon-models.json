{
  "name": "intraday-equities-horizon-models",
  "notes": "Rich-feature bakeoff at H=1165: full session set on ridge/tree; HAR+broadcast DLinear/MLP with Huber; binary PatchTST and transformer. n_ahead stays 1. Lockbox unread.",
  "pipeline": {
    "universe": {
      "uses": "intraday_equities-universe",
      "params": {
        "path": "configs/universe.json"
      },
      "notes": "The only market and science knob file. Add a candidate by editing this file plus the source configs; run documents do not restate names."
    },
    "alpaca": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip-split",
        "universe": "configs/universe.json",
        "start_ms": 1514764800000
      },
      "notes": "Split-adjusted historical SIP tape (source alpaca-sip-split, ADR-0063): AAPL's 2020 4-for-1, WMT's 2024 3-for-1 and the XLE/XLK 2-for-1s of December 2025 are all removed by the vendor, so no change of unit reads as a price move. start_ms is the study's start date, 2018-01-01 (ADR-0066) - it precedes the earliest bar any fold reads by 2y4m, and it puts XLF's 2016-09-19 XLRE spin-off, the one corporate action the vendor does NOT adjust, outside the readable window. Prices here are NOT the as-traded scale and are not comparable with any number recorded before 2026-09-03. Run from the child root."
    },
    "session": {
      "uses": "filter",
      "inputs": {
        "records": "$alpaca.records"
      },
      "params": {
        "where": [
          {
            "field": "session",
            "op": "==",
            "value": "rth"
          }
        ]
      },
      "notes": "Research uses regular-session rows; the store still keeps every vendor minute."
    },
    "features": {
      "uses": "intraday_equities-session-features",
      "inputs": {
        "records": "$session.records",
        "spec": "$universe.spec"
      },
      "params": {},
      "notes": "Session rows including HAR scales, volume/Amihud, CLV, calendar, and SPY residual."
    },
    "tradable": {
      "uses": "intraday_equities-keep-symbols",
      "inputs": {
        "records": "$features.records",
        "symbols": "$universe.tradable"
      },
      "params": {
        "field": "symbol"
      },
      "notes": "Allow-list is $universe.tradable. Reference names stay on the tape for features and never land here."
    },
    "label_train": {
      "uses": "intraday_equities-lead-labels",
      "inputs": {
        "records": "$tradable.records",
        "bars": "$session.records",
        "spec": "$universe.spec"
      },
      "params": {
        "lead": 1165,
        "split": "train",
        "train_end_ms": "$splits.train_end_ms",
        "val_start_ms": "$splits.val_start_ms",
        "val_end_ms": "$splits.val_end_ms"
      },
      "notes": "Same RTH-tape lead as the scan. Also emits y_up for the binary head. Lockbox unread."
    },
    "label_val": {
      "uses": "intraday_equities-lead-labels",
      "inputs": {
        "records": "$tradable.records",
        "bars": "$session.records",
        "spec": "$universe.spec"
      },
      "params": {
        "lead": 1165,
        "split": "val",
        "train_end_ms": "$splits.train_end_ms",
        "val_start_ms": "$splits.val_start_ms",
        "val_end_ms": "$splits.val_end_ms"
      },
      "notes": "Same RTH-tape lead as the scan. Also emits y_up for the binary head. Lockbox unread."
    },
    "ridge": {
      "uses": "dskit.pipeline.libs.sklearn:SklearnFit",
      "mode": "train",
      "inputs": {
        "rows": "$label_train.records"
      },
      "params": {
        "estimator": "sklearn.linear_model.Ridge",
        "estimator_params": {
          "alpha": 1.0
        },
        "features": [
          "ret_lag_0",
          "ret_lag_1",
          "ret_lag_2",
          "ret_lag_3",
          "ret_lag_4",
          "ret_lag_5",
          "ret_lag_6",
          "ret_lag_7",
          "ret_lag_8",
          "ret_lag_9",
          "ret_lag_10",
          "ret_lag_11",
          "ret_lag_12",
          "ret_lag_13",
          "ret_lag_14",
          "ret_lag_15",
          "ret_lag_16",
          "ret_lag_17",
          "ret_lag_18",
          "ret_lag_19",
          "ret_lag_20",
          "ret_lag_21",
          "ret_lag_22",
          "ret_lag_23",
          "ret_lag_24",
          "ret_lag_25",
          "ret_lag_26",
          "ret_lag_27",
          "ret_lag_28",
          "ret_lag_29",
          "ret_5m",
          "rv_5m",
          "range_5m",
          "vol_5m",
          "amihud_5m",
          "ret_15m",
          "rv_15m",
          "range_15m",
          "vol_15m",
          "amihud_15m",
          "ret_60m",
          "rv_60m",
          "range_60m",
          "vol_60m",
          "amihud_60m",
          "ret_1s",
          "rv_1s",
          "range_1s",
          "vol_1s",
          "amihud_1s",
          "ret_3s",
          "rv_3s",
          "range_3s",
          "vol_3s",
          "amihud_3s",
          "clv",
          "minutes_from_open",
          "minutes_to_close",
          "tod_sin",
          "tod_cos",
          "dow_sin",
          "dow_cos",
          "month_sin",
          "month_cos",
          "is_first_rth",
          "is_last_rth",
          "overnight_gap",
          "session_gap_days",
          "after_holiday",
          "ref_ret_SPY",
          "residual_SPY",
          "industry_consumer",
          "industry_energy",
          "industry_financials",
          "industry_healthcare",
          "industry_tech"
        ],
        "label": "y_next",
        "seed": 7
      },
      "notes": "Linear control on the full session column set."
    },
    "tree": {
      "uses": "dskit.pipeline.libs.sklearn:SklearnFit",
      "mode": "train",
      "inputs": {
        "rows": "$label_train.records"
      },
      "params": {
        "estimator": "sklearn.ensemble.HistGradientBoostingRegressor",
        "estimator_params": {
          "max_depth": 6,
          "learning_rate": 0.1
        },
        "features": [
          "ret_lag_0",
          "ret_lag_1",
          "ret_lag_2",
          "ret_lag_3",
          "ret_lag_4",
          "ret_lag_5",
          "ret_lag_6",
          "ret_lag_7",
          "ret_lag_8",
          "ret_lag_9",
          "ret_lag_10",
          "ret_lag_11",
          "ret_lag_12",
          "ret_lag_13",
          "ret_lag_14",
          "ret_lag_15",
          "ret_lag_16",
          "ret_lag_17",
          "ret_lag_18",
          "ret_lag_19",
          "ret_lag_20",
          "ret_lag_21",
          "ret_lag_22",
          "ret_lag_23",
          "ret_lag_24",
          "ret_lag_25",
          "ret_lag_26",
          "ret_lag_27",
          "ret_lag_28",
          "ret_lag_29",
          "ret_5m",
          "rv_5m",
          "range_5m",
          "vol_5m",
          "amihud_5m",
          "ret_15m",
          "rv_15m",
          "range_15m",
          "vol_15m",
          "amihud_15m",
          "ret_60m",
          "rv_60m",
          "range_60m",
          "vol_60m",
          "amihud_60m",
          "ret_1s",
          "rv_1s",
          "range_1s",
          "vol_1s",
          "amihud_1s",
          "ret_3s",
          "rv_3s",
          "range_3s",
          "vol_3s",
          "amihud_3s",
          "clv",
          "minutes_from_open",
          "minutes_to_close",
          "tod_sin",
          "tod_cos",
          "dow_sin",
          "dow_cos",
          "month_sin",
          "month_cos",
          "is_first_rth",
          "is_last_rth",
          "overnight_gap",
          "session_gap_days",
          "after_holiday",
          "ref_ret_SPY",
          "residual_SPY",
          "industry_consumer",
          "industry_energy",
          "industry_financials",
          "industry_healthcare",
          "industry_tech"
        ],
        "label": "y_next",
        "seed": 7
      },
      "notes": "Tabular control. Same 51+ session columns the scan had, plus vol/Amihud/CLV/3s."
    },
    "dlinear": {
      "uses": "dskit.pipeline.libs.torch_ts:TimeSeriesTrain",
      "mode": "train",
      "inputs": {
        "rows": "$label_train.records",
        "val_rows": "$label_val.records"
      },
      "params": {
        "arch": "dlinear",
        "head": "regression",
        "loss": "torch.nn.functional:smooth_l1_loss",
        "arch_params": {
          "dlinear": {}
        },
        "label": "y_next",
        "seq_len": 5,
        "channels": 6,
        "order": "recent_first",
        "features": [
          "ret_5m",
          "ret_15m",
          "ret_60m",
          "ret_1s",
          "ret_3s",
          "rv_5m",
          "rv_15m",
          "rv_60m",
          "rv_1s",
          "rv_3s",
          "range_5m",
          "range_15m",
          "range_60m",
          "range_1s",
          "range_3s",
          "vol_5m",
          "vol_15m",
          "vol_60m",
          "vol_1s",
          "vol_3s",
          "overnight_gap",
          "overnight_gap",
          "overnight_gap",
          "overnight_gap",
          "overnight_gap",
          "residual_SPY",
          "residual_SPY",
          "residual_SPY",
          "residual_SPY",
          "residual_SPY"
        ],
        "optimizer": "torch.optim:Adam",
        "optimizer_params": {
          "weight_decay": 0.0001
        },
        "epochs": 20,
        "lr": 0.001,
        "loader": {
          "batch_size": 512,
          "shuffle": true,
          "seed": 7
        },
        "device": "cuda",
        "monitor": "val_loss"
      },
      "notes": "HAR sequence (5m to 3s) plus broadcast overnight_gap and residual_SPY. Huber, 20 epochs."
    },
    "mlp": {
      "uses": "dskit.pipeline.libs.torch_ts:TimeSeriesTrain",
      "mode": "train",
      "inputs": {
        "rows": "$label_train.records",
        "val_rows": "$label_val.records"
      },
      "params": {
        "arch": "mlp",
        "head": "regression",
        "loss": "torch.nn.functional:smooth_l1_loss",
        "arch_params": {
          "mlp": {
            "hidden_size": 32
          }
        },
        "label": "y_next",
        "seq_len": 5,
        "channels": 6,
        "order": "recent_first",
        "features": [
          "ret_5m",
          "ret_15m",
          "ret_60m",
          "ret_1s",
          "ret_3s",
          "rv_5m",
          "rv_15m",
          "rv_60m",
          "rv_1s",
          "rv_3s",
          "range_5m",
          "range_15m",
          "range_60m",
          "range_1s",
          "range_3s",
          "vol_5m",
          "vol_15m",
          "vol_60m",
          "vol_1s",
          "vol_3s",
          "overnight_gap",
          "overnight_gap",
          "overnight_gap",
          "overnight_gap",
          "overnight_gap",
          "residual_SPY",
          "residual_SPY",
          "residual_SPY",
          "residual_SPY",
          "residual_SPY"
        ],
        "optimizer": "torch.optim:Adam",
        "optimizer_params": {
          "weight_decay": 0.0001
        },
        "epochs": 20,
        "lr": 0.001,
        "loader": {
          "batch_size": 512,
          "shuffle": true,
          "seed": 7
        },
        "device": "cuda",
        "monitor": "val_loss"
      },
      "notes": "Same HAR+broadcast vector as DLinear, no sequence structure."
    },
    "patchtst": {
      "uses": "dskit.pipeline.libs.torch_ts:TimeSeriesTrain",
      "mode": "train",
      "inputs": {
        "rows": "$label_train.records",
        "val_rows": "$label_val.records"
      },
      "params": {
        "arch": "patchtst",
        "head": "binary",
        "arch_params": {
          "patchtst": {
            "hidden_size": 16,
            "patch_len": 1
          }
        },
        "label": "y_up",
        "seq_len": 5,
        "channels": 6,
        "order": "recent_first",
        "features": [
          "ret_5m",
          "ret_15m",
          "ret_60m",
          "ret_1s",
          "ret_3s",
          "rv_5m",
          "rv_15m",
          "rv_60m",
          "rv_1s",
          "rv_3s",
          "range_5m",
          "range_15m",
          "range_60m",
          "range_1s",
          "range_3s",
          "vol_5m",
          "vol_15m",
          "vol_60m",
          "vol_1s",
          "vol_3s",
          "overnight_gap",
          "overnight_gap",
          "overnight_gap",
          "overnight_gap",
          "overnight_gap",
          "residual_SPY",
          "residual_SPY",
          "residual_SPY",
          "residual_SPY",
          "residual_SPY"
        ],
        "optimizer": "torch.optim:Adam",
        "optimizer_params": {
          "weight_decay": 0.0001
        },
        "epochs": 20,
        "lr": 0.001,
        "loader": {
          "batch_size": 512,
          "shuffle": true,
          "seed": 7
        },
        "device": "cuda",
        "monitor": "val_loss"
      },
      "notes": "Binary direction head on y_up. patch_len 1 so seq_len 5 is a complete patch."
    },
    "transformer": {
      "uses": "dskit.pipeline.libs.torch_ts:TimeSeriesTrain",
      "mode": "train",
      "inputs": {
        "rows": "$label_train.records",
        "val_rows": "$label_val.records"
      },
      "params": {
        "arch": "transformer",
        "head": "binary",
        "arch_params": {
          "transformer": {
            "hidden_size": 16,
            "nhead": 2
          }
        },
        "label": "y_up",
        "seq_len": 5,
        "channels": 6,
        "order": "recent_first",
        "features": [
          "ret_5m",
          "ret_15m",
          "ret_60m",
          "ret_1s",
          "ret_3s",
          "rv_5m",
          "rv_15m",
          "rv_60m",
          "rv_1s",
          "rv_3s",
          "range_5m",
          "range_15m",
          "range_60m",
          "range_1s",
          "range_3s",
          "vol_5m",
          "vol_15m",
          "vol_60m",
          "vol_1s",
          "vol_3s",
          "overnight_gap",
          "overnight_gap",
          "overnight_gap",
          "overnight_gap",
          "overnight_gap",
          "residual_SPY",
          "residual_SPY",
          "residual_SPY",
          "residual_SPY",
          "residual_SPY"
        ],
        "optimizer": "torch.optim:Adam",
        "optimizer_params": {
          "weight_decay": 0.0001
        },
        "epochs": 20,
        "lr": 0.001,
        "loader": {
          "batch_size": 512,
          "shuffle": true,
          "seed": 7
        },
        "device": "cuda",
        "monitor": "val_loss"
      },
      "notes": "One-layer transformer, binary head, same HAR+broadcast channels."
    },
    "select_ridge": {
      "uses": "intraday_equities-portfolio",
      "inputs": {
        "signal": "$ridge.signal",
        "records": "$label_val.records",
        "labeled": "$label_val.records",
        "tradable": "$universe.tradable"
      },
      "params": {
        "split": "val"
      },
      "notes": "Scalar one-pick on val. Binary heads score with logits; rank_ic still uses y_next."
    },
    "select_tree": {
      "uses": "intraday_equities-portfolio",
      "inputs": {
        "signal": "$tree.signal",
        "records": "$label_val.records",
        "labeled": "$label_val.records",
        "tradable": "$universe.tradable"
      },
      "params": {
        "split": "val"
      },
      "notes": "Scalar one-pick on val. Binary heads score with logits; rank_ic still uses y_next."
    },
    "select_dlinear": {
      "uses": "intraday_equities-portfolio",
      "inputs": {
        "signal": "$dlinear.signal",
        "records": "$label_val.records",
        "labeled": "$label_val.records",
        "tradable": "$universe.tradable"
      },
      "params": {
        "split": "val"
      },
      "notes": "Scalar one-pick on val. Binary heads score with logits; rank_ic still uses y_next."
    },
    "select_mlp": {
      "uses": "intraday_equities-portfolio",
      "inputs": {
        "signal": "$mlp.signal",
        "records": "$label_val.records",
        "labeled": "$label_val.records",
        "tradable": "$universe.tradable"
      },
      "params": {
        "split": "val"
      },
      "notes": "Scalar one-pick on val. Binary heads score with logits; rank_ic still uses y_next."
    },
    "select_patchtst": {
      "uses": "intraday_equities-portfolio",
      "inputs": {
        "signal": "$patchtst.signal",
        "records": "$label_val.records",
        "labeled": "$label_val.records",
        "tradable": "$universe.tradable"
      },
      "params": {
        "split": "val"
      },
      "notes": "Scalar one-pick on val. Binary heads score with logits; rank_ic still uses y_next."
    },
    "select_transformer": {
      "uses": "intraday_equities-portfolio",
      "inputs": {
        "signal": "$transformer.signal",
        "records": "$label_val.records",
        "labeled": "$label_val.records",
        "tradable": "$universe.tradable"
      },
      "params": {
        "split": "val"
      },
      "notes": "Scalar one-pick on val. Binary heads score with logits; rank_ic still uses y_next."
    }
  },
  "splits": {
    "kind": "time",
    "train_end_ms": 1764547199000,
    "val_start_ms": 1764633600000,
    "val_end_ms": 1772323199000,
    "test_end_ms": 1788134399000,
    "notes": "Chronological cuts with a one-day embargo. The latest six months are the lockbox (test); this bakeoff stops at val_end."
  },
  "outputs": {
    "run_root": ""
  },
  "tracking": {
    "sinks": [
      {
        "kind": "dskit.pipeline.libs.mlflow:MlflowTracker",
        "params": {
          "tracking_uri": "sqlite:///mlruns.db",
          "experiment": "intraday_equities"
        },
        "notes": "Local sqlite beside the invoking cwd. One experiment so cadence and HPO runs compare in one UI."
      }
    ],
    "notes": "Excluded from identity \u2014 where metrics land is not what the run computes."
  }
}
