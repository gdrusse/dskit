{
  "name": "p13-pooled-model-zoo",
  "notes": "ADR-0101/0102 four-way pooled zoo: native LightGBM and Torch MLP run first, followed by frozen Kronos-small hidden states fused with explicit side features into LightGBM and Torch MLP. Each family owns train-only HPO; the two Kronos heads share one verified embedding cache.",
  "pipeline": {
    "universe": {
      "uses": "intraday_equities-universe",
      "params": {
        "path": "configs/universe-p13-pooled.json"
      }
    },
    "source_a": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip-split",
        "universe": "configs/universe-p13-pooled.json",
        "start_ms": 1514764800000,
        "sessions": [
          "rth"
        ],
        "shared_fields": [
          "symbol",
          "ts"
        ]
      },
      "notes": "alpaca-sip-split holds eleven P10 names and SPY; SPY is the reference every group build reads from this source under its own group universe bound."
    },
    "source_c": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip-split-c",
        "universe": "configs/universe-p13-pooled.json",
        "start_ms": 1514764800000,
        "sessions": [
          "rth"
        ],
        "shared_fields": [
          "symbol",
          "ts"
        ]
      }
    },
    "source_d": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip-split-d",
        "universe": "configs/universe-p13-pooled.json",
        "start_ms": 1514764800000,
        "sessions": [
          "rth"
        ],
        "shared_fields": [
          "symbol",
          "ts"
        ]
      }
    },
    "source_e": {
      "uses": "intraday_equities-bars",
      "params": {
        "root": "./ob",
        "source": "alpaca-sip-split-e",
        "universe": "configs/universe-p13-pooled.json",
        "start_ms": 1514764800000,
        "sessions": [
          "rth"
        ],
        "shared_fields": [
          "symbol",
          "ts"
        ]
      }
    },
    "pooled": {
      "uses": "concat",
      "inputs": {
        "a": "$source_a.records",
        "c": "$source_c.records",
        "d": "$source_d.records",
        "e": "$source_e.records"
      },
      "params": {
        "shape": "records",
        "provenance_waiver": "Each immutable MarketRecord already carries its source; the five symbol namespaces are disjoint and checked below.",
        "key": "symbol",
        "consume_inputs": true
      },
      "notes": "Only source groups containing the 25 selected names are read; their symbol namespaces are disjoint and source_a also supplies SPY."
    },
    "features": {
      "uses": "intraday_equities-session-features",
      "inputs": {
        "records": "$pooled.merged",
        "spec": "$universe.spec"
      },
      "params": {
        "lookback": 20,
        "layout": "columns",
        "dtype": "float32",
        "include_klines": true,
        "cache_dir": "./pipeline_cache/p13-features-f32-kronos-v1",
        "momentum_horizons": [
          {
            "width": 3,
            "tag": "3m",
            "cross_session": false
          },
          {
            "width": 120,
            "tag": "2h",
            "cross_session": true
          },
          {
            "width": 180,
            "tag": "3h",
            "cross_session": true
          },
          {
            "width": 780,
            "tag": "2s",
            "cross_session": true
          },
          {
            "width": 1950,
            "tag": "1w",
            "cross_session": true
          }
        ]
      }
    },
    "scan": {
      "uses": "intraday_equities-no-information-scan",
      "inputs": {
        "records": "$features.records",
        "bars": "$features.tape",
        "spec": "$universe.spec"
      },
      "params": {
        "split": "val",
        "train_end_ms": "$splits.train_end_ms",
        "train_start_ms": "$splits.train_start_ms",
        "val_start_ms": "$splits.val_start_ms",
        "val_end_ms": "$splits.val_end_ms",
        "label_scale": "vol",
        "label_residual": "SPY",
        "label_residual_self": "raw",
        "fit_symbols": [
          "LLY",
          "QQQ",
          "XLF",
          "XLE",
          "XLK",
          "BAC",
          "SMH",
          "IWM",
          "XBI",
          "FCX",
          "DAL",
          "NRG",
          "MET",
          "MSTR",
          "NOW",
          "LULU",
          "PANW",
          "INTC",
          "CIEN",
          "LRCX",
          "TER",
          "BIDU",
          "LITE",
          "ADBE",
          "ANET"
        ],
        "lead_start": 1,
        "lead_step": 1,
        "lead_stop": 1,
        "score_period_ms": 1800000,
        "estimator": "lightgbm.LGBMRegressor",
        "estimator_params": {
          "n_estimators": 800,
          "learning_rate": 0.005,
          "num_leaves": 4,
          "max_depth": 2,
          "min_child_samples": 2000,
          "reg_lambda": 100.0,
          "reg_alpha": 0.1,
          "subsample": 0.5,
          "subsample_freq": 1,
          "colsample_bytree": 0.3,
          "n_jobs": 8,
          "random_state": 0,
          "verbosity": -1
        },
        "score_symbols": [
          "LLY",
          "QQQ",
          "XLF",
          "XLE",
          "XLK",
          "BAC",
          "SMH",
          "IWM",
          "XBI",
          "FCX",
          "DAL",
          "NRG",
          "MET",
          "MSTR",
          "NOW",
          "LULU",
          "PANW",
          "INTC",
          "CIEN",
          "LRCX",
          "TER",
          "BIDU",
          "LITE",
          "ADBE",
          "ANET"
        ]
      }
    }
  },
  "walkforward": {
    "objective": "$scan.metrics.val_ic",
    "select": "max",
    "first": "2022-05-06",
    "step_days": 63,
    "count": 20,
    "val_days": 63,
    "embargo_days": 5,
    "train_days": 730
  },
  "tracking": {
    "sinks": [
      {
        "kind": "dskit.pipeline.libs.mlflow:MlflowTracker",
        "params": {
          "tracking_uri": "sqlite:///mlruns.db",
          "experiment": "intraday_equities"
        },
        "notes": "Local sqlite beside the invoking cwd."
      }
    ],
    "notes": "Excluded from identity - where metrics land is not what it computes."
  },
  "outputs": {
    "run_root": "./pipeline_runs"
  },
  "stages": {
    "calendar": {
      "uses": "dskit.pipeline.program_calendar:ProgramCalendar",
      "params": {
        "path": "program-calendar-p13-model-zoo.json",
        "phase": "model_zoo"
      }
    },
    "memory": {
      "uses": "intraday_equities.modelability_study:MemoryPreflightStage",
      "params": {
        "memory_limit_bytes": 18253611008,
        "groups": {
          "a": {
            "universe": "configs/universe-p12-a.json",
            "sources": ["source_a"]
          },
          "c": {
            "universe": "configs/universe-p12-c.json",
            "sources": ["source_a", "source_c"]
          },
          "d": {
            "universe": "configs/universe-p13-d-selected.json",
            "sources": ["source_a", "source_d"]
          },
          "e": {
            "universe": "configs/universe-p13-e-selected.json",
            "sources": ["source_a", "source_e"]
          }
        }
      },
      "notes": "Build four bounded P13 group caches containing the frozen P12 feature matrix, label tape, and causal five-minute OHLCVA bars. The P12 caches remain untouched because write-once cache identity changes when K-lines are added. Groups D and E use P13 cohort-only universes plus SPY so unused P12 breadth candidates cannot inflate peak memory."
    },
    "materialize": {
      "uses": "intraday_equities.model_zoo:PooledGate3ZooCandidates",
      "inputs": {
        "preflight": "$memory.passed",
        "caches": "$memory.groups"
      },
      "params": {
        "gate3_artifact": "../pipeline_runs/p12-g3-recovery-staged-2026-02-28-a1f293a2/stages/gate3_recovery.json",
        "gate3_sha256": "098b21eaef6ee0260753d4f981ca2337bccae406b9efd394284d9b180ba03bd0",
        "cache_groups": ["a", "c", "d", "e"],
        "templates": [
          {
            "id": "lgbm",
            "family": "pooled-lightgbm",
            "representation": "pooled-tabular-native-category",
            "feature_policy": "all frozen P12 features; symbol_code is native categorical",
            "feature_source": "tabular",
            "seed_policy": "fixed seed 0 with purged inner HPO",
            "compute_class": "cpu-medium",
            "compute_rank": 1,
            "enabled": true,
            "model": {
              "estimator": "lightgbm.LGBMRegressor",
              "estimator_params": {
                "n_estimators": 600,
                "learning_rate": 0.01,
                "num_leaves": 8,
                "max_depth": 3,
                "min_child_samples": 1000,
                "reg_lambda": 100.0,
                "reg_alpha": 0.1,
                "subsample": 0.7,
                "subsample_freq": 1,
                "colsample_bytree": 0.5,
                "n_jobs": 8,
                "random_state": 0,
                "verbosity": -1
              },
              "hpo_trials": 4,
              "hpo_seed": 0,
              "hpo_val_days": 63,
              "hpo_embargo_days": 5,
              "hpo_objective": "ic",
              "hpo_space": {
                "num_leaves": [
                  4,
                  8,
                  16
                ],
                "max_depth": [
                  2,
                  3,
                  4
                ],
                "min_child_samples": [
                  500,
                  1000,
                  2000
                ],
                "reg_lambda": [
                  10.0,
                  100.0,
                  1000.0
                ],
                "reg_alpha": [
                  0.0,
                  0.1,
                  1.0
                ],
                "colsample_bytree": [
                  0.3,
                  0.5,
                  0.7
                ]
              }
            }
          },
          {
            "id": "torch-mlp",
            "family": "pooled-torch-mlp",
            "representation": "standardized-tabular-plus-symbol-embedding",
            "feature_policy": "all frozen P12 continuous features plus learned symbol embedding",
            "feature_source": "tabular",
            "seed_policy": "fixed seed 0 with purged inner HPO",
            "compute_class": "gpu-medium",
            "compute_rank": 2,
            "enabled": true,
            "model": {
              "estimator": "dskit.pipeline.libs.torch_ts.CategoricalEmbeddingMLPRegressor",
              "estimator_params": {
                "hidden_size": 64,
                "hidden_depth": 2,
                "embedding_dim": 8,
                "epochs": 8,
                "lr": 0.001,
                "weight_decay": 0.0001,
                "batch_size": 4096,
                "dropout": 0.1,
                "seed": 0,
                "standardize": true
              },
              "hpo_trials": 4,
              "hpo_seed": 0,
              "hpo_val_days": 63,
              "hpo_embargo_days": 5,
              "hpo_objective": "ic",
              "hpo_space": {
                "hidden_size": [
                  32,
                  64,
                  128
                ],
                "hidden_depth": [
                  1,
                  2,
                  3
                ],
                "embedding_dim": [
                  4,
                  8,
                  16
                ],
                "epochs": [
                  5,
                  10
                ],
                "lr": [
                  0.0003,
                  0.001,
                  0.003
                ],
                "weight_decay": [
                  1e-05,
                  0.0001,
                  0.001
                ],
                "dropout": [
                  0.0,
                  0.1,
                  0.2
                ]
              }
            }
          },
          {
            "id": "kronos-lgbm",
            "family": "pooled-kronos-lightgbm",
            "representation": "frozen-kronos-small-hidden-plus-side-features",
            "feature_policy": "512 causal session-local Kronos hidden columns plus calendar, SPY return, and native symbol category",
            "feature_source": "kronos",
            "seed_policy": "fixed seed 0 with purged inner HPO",
            "compute_class": "gpu-embed-cpu-medium",
            "compute_rank": 3,
            "enabled": true,
            "kronos": {
              "source_root": "../../third_party/Kronos",
              "source_revision": "67b630e67f6a18c9e9be918d9b4337c960db1e9a",
              "onboarding_root": "./ob",
              "tokenizer_snapshot": "c101158cfee9ab7424a21acbf92963f714a7d32ca3e0f34721fe514ebf67ed87",
              "model_snapshot": "bb1bb0b2cede75c5bf72c9411d30eb3d55e762314b5513cea07b3a1b6d400b55",
              "cache_dir": "./pipeline_cache/p13-kronos-small-prefix-v2",
              "score_period_ms": 1800000,
              "batch_size": 128,
              "device": "cuda",
              "dtype": "float16",
              "timezone": "America/New_York",
              "encoder_contract": "upstream-prefix-mean-std-final-hidden-v1",
              "feature_names": [
                "minutes_from_open",
                "minutes_to_close",
                "tod_sin",
                "tod_cos",
                "dow_sin",
                "dow_cos",
                "month_sin",
                "month_cos",
                "is_first_rth",
                "is_last_rth",
                "session_gap_days",
                "after_holiday",
                "ref_ret_SPY"
              ]
            },
            "model": {
              "estimator": "lightgbm.LGBMRegressor",
              "estimator_params": {
                "n_estimators": 500,
                "learning_rate": 0.01,
                "num_leaves": 8,
                "max_depth": 3,
                "min_child_samples": 500,
                "reg_lambda": 100.0,
                "reg_alpha": 0.1,
                "subsample": 0.7,
                "subsample_freq": 1,
                "colsample_bytree": 0.35,
                "n_jobs": 8,
                "random_state": 0,
                "verbosity": -1
              },
              "hpo_trials": 4,
              "hpo_seed": 0,
              "hpo_val_days": 63,
              "hpo_embargo_days": 5,
              "hpo_objective": "ic",
              "hpo_space": {
                "num_leaves": [4, 8, 16, 31],
                "max_depth": [2, 3, 4, 5],
                "min_child_samples": [250, 500, 1000],
                "reg_lambda": [10.0, 100.0, 1000.0],
                "reg_alpha": [0.0, 0.1, 1.0],
                "colsample_bytree": [0.2, 0.35, 0.5]
              }
            }
          },
          {
            "id": "kronos-torch-mlp",
            "family": "pooled-kronos-torch-mlp",
            "representation": "frozen-kronos-small-hidden-plus-side-features",
            "feature_policy": "512 causal session-local Kronos hidden columns plus calendar, SPY return, and learned symbol embedding",
            "feature_source": "kronos",
            "seed_policy": "fixed seed 0 with purged inner HPO",
            "compute_class": "gpu-medium",
            "compute_rank": 4,
            "enabled": true,
            "kronos": {
              "source_root": "../../third_party/Kronos",
              "source_revision": "67b630e67f6a18c9e9be918d9b4337c960db1e9a",
              "onboarding_root": "./ob",
              "tokenizer_snapshot": "c101158cfee9ab7424a21acbf92963f714a7d32ca3e0f34721fe514ebf67ed87",
              "model_snapshot": "bb1bb0b2cede75c5bf72c9411d30eb3d55e762314b5513cea07b3a1b6d400b55",
              "cache_dir": "./pipeline_cache/p13-kronos-small-prefix-v2",
              "score_period_ms": 1800000,
              "batch_size": 128,
              "device": "cuda",
              "dtype": "float16",
              "timezone": "America/New_York",
              "encoder_contract": "upstream-prefix-mean-std-final-hidden-v1",
              "feature_names": [
                "minutes_from_open",
                "minutes_to_close",
                "tod_sin",
                "tod_cos",
                "dow_sin",
                "dow_cos",
                "month_sin",
                "month_cos",
                "is_first_rth",
                "is_last_rth",
                "session_gap_days",
                "after_holiday",
                "ref_ret_SPY"
              ]
            },
            "model": {
              "estimator": "dskit.pipeline.libs.torch_ts.CategoricalEmbeddingMLPRegressor",
              "estimator_params": {
                "hidden_size": 128,
                "hidden_depth": 2,
                "embedding_dim": 8,
                "epochs": 8,
                "lr": 0.001,
                "weight_decay": 0.0001,
                "batch_size": 4096,
                "dropout": 0.1,
                "seed": 0,
                "standardize": true
              },
              "hpo_trials": 4,
              "hpo_seed": 0,
              "hpo_val_days": 63,
              "hpo_embargo_days": 5,
              "hpo_objective": "ic",
              "hpo_space": {
                "hidden_size": [64, 128, 256],
                "hidden_depth": [1, 2, 3],
                "embedding_dim": [4, 8, 16],
                "epochs": [5, 10],
                "lr": [0.0003, 0.001, 0.003],
                "weight_decay": [1e-05, 0.0001, 0.001],
                "dropout": [0.0, 0.1, 0.2]
              }
            }
          }
        ],
        "path_protocol": {
          "forecast_strategy": "direct_per_lead",
          "horizon_weighting": "equal_asset_equal_within_asset",
          "fit_universe": "all_gate3_passers_each_lead",
          "score_universe": "certified_horizon_includes_lead"
        }
      }
    },
    "plan": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkPlan",
      "inputs": {
        "phase": "$calendar.phase",
        "calendar_sha256": "$calendar.calendar_sha256",
        "candidates": "$materialize.candidates"
      },
      "params": {
        "protocol": {
          "attempt_family": "intraday-equities-p13-pooled-model-zoo",
          "primary_score": "equal-stock and equal-within-stock mean train-scaled squared-error improvement over each stock's train-only mean",
          "null_baseline": "per-stock train-only no-information mean",
          "cost_model": "one pooled direct fit per lead and fold; declared compute ranks",
          "lockbox": "no candidate may read at or after 2026-03-01",
          "decision_rule": "compare paired outer-fold path scores; report only, never auto-promote",
          "alpha": 0.05,
          "comparison_hac_lags": 1,
          "multiplicity_method": "bonferroni_all_pairwise",
          "indifference_method": "paired_fold_newey_west_no_detectable_difference"
        },
        "contract_paths": [
          "pipeline.universe",
          "pipeline.features_a",
          "pipeline.features_c",
          "pipeline.features_d",
          "pipeline.features_e",
          "pipeline.pooled_features_a",
          "pipeline.pooled_features_c",
          "pipeline.pooled_features_d",
          "pipeline.pooled_features_e",
          "pipeline.pooled_tape_a",
          "pipeline.pooled_tape_c",
          "pipeline.pooled_tape_d",
          "pipeline.pooled_tape_e",
          "pipeline.pooled_features",
          "pipeline.reference_tape",
          "pipeline.scan_h01.uses",
          "pipeline.scan_h01.inputs.bars",
          "pipeline.scan_h01.inputs.spec",
          "pipeline.scan_h01.params.split",
          "pipeline.scan_h01.params.label_scale",
          "pipeline.scan_h01.params.label_residual",
          "pipeline.scan_h01.params.label_residual_self",
          "pipeline.scan_h01.params.fit_symbols",
          "pipeline.scan_h01.params.score_symbols",
          "pipeline.scan_h01.params.lead_start",
          "pipeline.scan_h01.params.lead_step",
          "pipeline.scan_h01.params.lead_stop",
          "pipeline.scan_h01.params.score_period_ms",
          "pipeline.scan_h01.params.common_lead_stop",
          "pipeline.scan_h01.params.common_origin_policy",
          "pipeline.path.uses",
          "pipeline.path.params.split",
          "pipeline.path.params.asset_horizons",
          "pipeline.path.params.horizon_weighting",
          "pipeline.path.params.score",
          "walkforward.objective",
          "walkforward.select",
          "walkforward.first",
          "walkforward.step_days",
          "walkforward.count",
          "walkforward.val_days",
          "walkforward.embargo_days",
          "walkforward.train_days"
        ]
      }
    },
    "approval": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkApproval",
      "inputs": {
        "inventory_sha256": "$plan.inventory_sha256"
      },
      "params": {
        "approved_inventory_sha256": "8731619d0eabb93246ebf72b6993f4a2e858c05bb775eb4a0ef5f6c589b33605",
        "approved_by": "owner",
        "approval_note": "Owner authorized this exact four-candidate pooled inventory: native LightGBM, Torch MLP, frozen Kronos hidden plus LightGBM, and frozen Kronos hidden plus Torch MLP. Each candidate uses four inner HPO trials as a low-budget exploratory screen, not an exhaustive optimized ceiling."
      }
    },
    "run": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkRun",
      "inputs": {
        "candidates": "$plan.candidates",
        "approval": "$approval.approval"
      }
    },
    "compare": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkCompare",
      "inputs": {
        "runs": "$run.runs",
        "protocol": "$plan.protocol",
        "contracts": "$plan.contracts",
        "approval": "$approval.approval"
      }
    }
  }
}
