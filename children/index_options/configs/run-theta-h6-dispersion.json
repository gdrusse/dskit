                "field": "atm_iv"
              },
              {
                "field": "atm_iv"
              }
            ]
          },
          "rv2": {
            "op": "mul",
            "args": [
              {
                "field": "rv_ann"
              },
              {
                "field": "rv_ann"
              }
            ]
          }
        }
      },
      "notes": "Squares for the equal-weight sums."
    },
    "daily": {
