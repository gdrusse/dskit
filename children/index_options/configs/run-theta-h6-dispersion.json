    "names_sq2": {
      "uses": "dskit.pipeline.kinds_compute:ComputeFields",
      "inputs": {
        "records": "$names_sq.records"
      },
      "params": {
        "fields": {
          "iv2": {
            "op": "mul",
            "args": [
