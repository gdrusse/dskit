    },
    "daily_ok": {
      "uses": "filter",
      "inputs": {
        "records": "$with_spy.records"
      },
      "params": {
        "where": [
          {
            "field": "n",
            "op": ">=",
            "value": 50
          },
          {
            "field": "iv_spx",
            "op": ">",
