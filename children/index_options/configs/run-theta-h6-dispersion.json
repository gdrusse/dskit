        ]
      },
      "notes": "Dates with at least 50 names (the basket) and both index legs."
    },
    "rho": {
      "uses": "dskit.pipeline.kinds_compute:ComputeFields",
      "inputs": {
        "records": "$daily_ok.records"
      },
      "params": {
        "fields": {
          "rho_implied": {
            "op": "div",
            "args": [
              {
                "op": "sub",
                "args": [
                  {
                    "op": "mul",
                    "args": [
                      {
                        "field": "iv_spx"
                      },
                      {
                        "field": "iv_spx"
                      }
                    ]
                  },
                  {
                    "op": "div",
                    "args": [
                      {
                        "field": "s_iv2"
                      },
                      {
                        "op": "mul",
                        "args": [
                          {
                            "field": "n"
                          },
                          {
                            "field": "n"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "op": "div",
                "args": [
                  {
                    "op": "sub",
                    "args": [
                      {
                        "op": "mul",
                        "args": [
                          {
                            "field": "s_iv"
                          },
                          {
                            "field": "s_iv"
                          }
                        ]
                      },
                      {
                        "field": "s_iv2"
                      }
                    ]
                  },
                  {
                    "op": "mul",
                    "args": [
                      {
                        "field": "n"
                      },
                      {
                        "field": "n"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "rho_realized": {
            "op": "div",
            "args": [
              {
                "op": "sub",
                "args": [
                  {
                    "op": "mul",
                    "args": [
                      {
                        "op": "mul",
                        "args": [
                          {
                            "field": "spy_rv"
                          },
                          {
                            "const": 15.874507866387544
                          }
                        ]
                      },
                      {
                        "op": "mul",
                        "args": [
                          {
                            "field": "spy_rv"
                          },
                          {
                            "const": 15.874507866387544
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "div",
                    "args": [
                      {
                        "field": "s_rv2"
                      },
                      {
                        "op": "mul",
                        "args": [
                          {
                            "field": "n"
                          },
                          {
                            "field": "n"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "op": "div",
                "args": [
                  {
                    "op": "sub",
                    "args": [
                      {
                        "op": "mul",
                        "args": [
                          {
                            "field": "s_rv"
                          },
                          {
                            "field": "s_rv"
                          }
                        ]
                      },
                      {
                        "field": "s_rv2"
                      }
                    ]
                  },
                  {
                    "op": "mul",
                    "args": [
                      {
                        "field": "n"
                      },
                      {
                        "field": "n"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "notes": "Average pairwise correlation implied by an index variance over an equal-weight basket: rho = (sigma_I^2 - sum w^2 sigma^2) / (sum_{i!=j} w w sigma_i sigma_j) with w = 1/n, so rho = (sigma_I^2 - S2/n^2) / ((S1^2 - S2)/n^2), S1 = sum of vols and S2 = sum of variances. Implied: SPX's 30-day ATM vol and the names' 30-day ATM vols; realized: SPY's and the names' forward realized vols. EQUAL-WEIGHT PROXY STATED: the basket is the equal-weight tested names, not the index's cap-weighted constituents (no constituent list is onboarded), so the premium carries a basis that is not zero; the pre-registered statistic is the premium itself."
    },
    "premium": {
      "uses": "dskit.pipeline.kinds_compute:ComputeFields",
      "inputs": {
        "records": "$rho.records"
      },
      "params": {
        "fields": {
          "corr_premium": {
            "op": "sub",
            "args": [
              {
                "field": "rho_implied"
              },
              {
                "field": "rho_realized"
              }
            ]
          }
        }
      },
      "notes": "Correlation premium = implied minus realized average correlation."
    },
    "phased": {
