      "inputs": {
        "records": "$phased.records"
      },
      "params": {
        "stamp_field": "date",
        "value_field": "corr_premium",
        "by": [
          "half"
        ],
        "bucket": "day",
        "h_steps": 21,
        "bootstrap": {
          "block_days": 90,
          "replicates": 2000,
          "seed": 20261012,
          "level": 0.9
        }
      },
      "notes": "PRIMARY: the daily correlation premium, tested one-sided E <= 0 with the Newey-West band over the 21 overlapping daily stamps of a 31-day label, overall and by half. Pass: mean > 0, t >= 2.5 in BOTH halves."
    },
    "implied_series": {
      "uses": "dskit.pipeline.kinds_series:StampSeriesStats",
      "inputs": {
        "records": "$phased.records"
      },
