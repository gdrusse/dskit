      "notes": "Audit rows, overwritten on a rerun: the run directory keeps the hashed record."
    },
    "primary_trades": {
      "uses": "filter",
      "inputs": {
        "records": "$returns.records"
      },
      "params": {
        "where": [
          {
            "field": "structure",
            "op": "==",
            "value": "put_write"
          },
          {
            "field": "symbol",
            "op": "==",
            "value": "SPX"
          }
        ]
      },
      "notes": "D7: the ONE primary cell, SPX put-write at zero fees, return on notional. All other cells and sensitivities are descriptive."
    },
    "primary_sharpe": {
      "uses": "dskit.pipeline.kinds_series:StampSeriesStats",
      "inputs": {
        "records": "$primary_trades.records"
      },
      "params": {
        "stamp_field": "open_date",
        "value_field": "ret_notional",
        "bucket": "month",
        "bucket_agg": "sum",
        "periods_per_year": 12,
        "h_steps": 1,
        "bootstrap": {
          "block_days": 90,
          "replicates": 2000,
          "seed": 20261012,
          "level": 0.9
        },
        "hurdle": 0.5
      },
      "notes": "D7 PRIMARY: SPX put-write only. Monthly summed notional returns; pass only if the lower end (5th percentile) of the two-sided 90% block-bootstrap interval for annualised Sharpe exceeds 0.5. Measurement, not proof."
    },
    "report": {
      "uses": "run-report",
      "inputs": {
        "orders": "$orders.summary",
        "sharpe": "$sharpe.summary",
        "capital_sharpe": "$capital_sharpe.summary",
        "ledger": "$ledger.summary",
        "sharpe_fee": "$sharpe_fee.summary",
        "capital_sharpe_fee": "$capital_sharpe_fee.summary",
        "ledger_fee": "$ledger_fee.summary",
        "primary": "$primary_sharpe.summary"
      },
      "params": {
        "title": "H5 index harvests at NBBO",
        "sections": [
          "stages"
        ]
      },
      "notes": "evidence.md renders the node summaries; evidence.json holds every value."
    }
  }
}
