{
  "name": "cdf-horizon-coverage",
  "notes": "JSON-only exact-horizon coverage selection. Tickers are foreach.keys (use a singleton for one ticker); source is pipeline.source.params. The standard runner persists full coverage/listed counts and winners in carry.json and a chart per ticker under artifacts/. Search actual settlement-close calendar days 1 through 45. Count distinct entry dates with a prepared eligible nine-quantile option-implied proxy and an observed target; no target value, model loss, or skill enters ranking. The upstream validated CDF panel owns quantile ordering and ETF settlement convention; these interior proxy quantiles do not constitute fully observed tails or calibrated physical probabilities. Historical coverage is not a prospective calendar policy. Argmax is groupby/max/filter; minimum DTE breaks ties. No training or new CDF construction is performed.",
  "pipeline": {
    "source": {
      "uses": "dskit.pipeline.libs.observations:ObservationRows",
      "params": {
        "root": "./pipeline_runs/cdf-horizon-source",
        "source": "cdf-horizon-panel",
        "stream": "input_panel",
        "key_fields": [
          "symbol",
          "quote_date",
          "expiry"
        ],
        "ts_field": "quote_date",
        "ts_unit": "iso"
      },
      "notes": "Import the existing options-derived panel using source-cdf-horizon-panel.json and the standard localtables onboarding CLI. Immutable acquisition and source fingerprint bind the run."
    }
  },
  "outputs": {
    "run_root": "./pipeline_runs"
  },
  "foreach": {
    "keys": [
      "QQQ",
      "SPY",
      "IWM"
    ],
    "notes": "The only ticker setting: one or several supported symbols in the prepared source. One shared acquisition is read once; each ticker gets an independent argmax and full coverage distribution.",
    "pipeline": {
      "cohort": {
        "uses": "filter",
        "inputs": {
          "records": "$source.records"
        },
        "params": {
          "where": [
            {
              "field": "symbol",
              "op": "==",
              "value": "$each"
            },
            {
              "field": "actual_calendar_dte",
              "op": ">=",
              "value": 1
            },
            {
              "field": "actual_calendar_dte",
              "op": "<=",
              "value": 45
            }
          ]
        }
      },
      "listed_counts": {
        "uses": "groupby",
        "inputs": {
          "records": "$cohort.records"
        },
        "params": {
          "keys": [
            "symbol",
            "actual_calendar_dte"
          ],
          "aggregates": {
            "listed_dates": {
              "op": "nunique",
              "field": "quote_date"
            },
            "listed_forecasts": {
              "op": "count"
            }
          }
        },
        "notes": "Prepared-panel counts already require observed settlement outcomes and upstream path/feature admissibility; they are not raw archive counts."
      },
      "complete_cdf": {
        "uses": "filter",
        "inputs": {
          "records": "$cohort.records"
        },
        "params": {
          "where": [
            {
              "field": "rn_proxy_eligible",
              "op": "==",
              "value": 1
            },
            {
              "field": "terminal_return",
              "op": "!=",
              "value": null
            },
            {
              "field": "rn_q_0100",
              "op": "!=",
              "value": null
            },
            {
              "field": "rn_q_0500",
              "op": "!=",
              "value": null
            },
            {
              "field": "rn_q_1000",
              "op": "!=",
              "value": null
            },
            {
              "field": "rn_q_2500",
              "op": "!=",
              "value": null
            },
            {
              "field": "rn_q_5000",
              "op": "!=",
              "value": null
            },
            {
              "field": "rn_q_7500",
              "op": "!=",
              "value": null
            },
            {
              "field": "rn_q_9000",
              "op": "!=",
              "value": null
            },
            {
              "field": "rn_q_9500",
              "op": "!=",
              "value": null
            },
            {
              "field": "rn_q_9900",
              "op": "!=",
              "value": null
            }
          ]
        },
        "notes": "The localtables importer converts NaN to null and refuses infinity. Proxy eligibility and finite ordered quantiles were verified in the canonical upstream preparation."
      },
      "coverage": {
        "uses": "groupby",
        "inputs": {
          "records": "$complete_cdf.records"
        },
        "params": {
          "keys": [
            "symbol",
            "actual_calendar_dte"
          ],
          "aggregates": {
            "eligible_dates": {
              "op": "nunique",
              "field": "quote_date"
            },
            "eligible_forecasts": {
              "op": "count"
            },
            "expiry_series": {
              "op": "nunique",
              "field": "expiry"
            }
          }
        },
        "notes": "Full per-horizon records are retained in the standard runner carry.json under coverage__<ticker>.records (at most 45 small rows per ticker). Horizons with no eligible dates are absent, not fabricated; absence means zero within this source cohort."
      },
      "selection_group": {
        "uses": "derive",
        "inputs": {
          "records": "$coverage.records"
        },
        "params": {
          "field": "selection_group",
          "cases": [
            {
              "when": [],
              "value": "all"
            }
          ]
        }
      },
      "maximum": {
        "uses": "groupby",
        "inputs": {
          "records": "$selection_group.records"
        },
        "params": {
          "keys": [
            "selection_group"
          ],
          "aggregates": {
            "eligible_dates": {
              "op": "max",
              "field": "eligible_dates"
            }
          }
        }
      },
      "maximum_value": {
        "uses": "keyby",
        "inputs": {
          "records": "$maximum.records"
        },
        "params": {
          "key": "selection_group",
          "value": "eligible_dates"
        }
      },
      "maximizers": {
        "uses": "filter",
        "inputs": {
          "records": "$selection_group.records"
        },
        "params": {
          "where": [
            {
              "field": "eligible_dates",
              "op": "==",
              "value": "$maximum_value.table.all"
            }
          ]
        }
      },
      "tie_break": {
        "uses": "groupby",
        "inputs": {
          "records": "$maximizers.records"
        },
        "params": {
          "keys": [
            "selection_group"
          ],
          "aggregates": {
            "days_to_expiry": {
              "op": "min",
              "field": "actual_calendar_dte"
            }
          }
        },
        "notes": "Deterministic argmax: choose the shortest exact DTE among equal largest date counts. An empty cohort refuses through the missing maximum reference."
      },
      "selected_dte": {
        "uses": "keyby",
        "inputs": {
          "records": "$tie_break.records"
        },
        "params": {
          "key": "selection_group",
          "value": "days_to_expiry"
        }
      },
      "winner": {
        "uses": "filter",
        "inputs": {
          "records": "$coverage.records"
        },
        "params": {
          "where": [
            {
              "field": "actual_calendar_dte",
              "op": "==",
              "value": "$selected_dte.table.all"
            }
          ]
        }
      },
      "coverage_figure": {
        "uses": "dskit.pipeline.libs.matplotlib:DeclaredFigure",
        "inputs": {
          "rows": "$coverage.records"
        },
        "params": {
          "title": "$each",
          "xlabel": "Exact days to historical settlement close",
          "ylabel": "Distinct eligible entry dates",
          "filename": "coverage.png",
          "marks": [
            {
              "kind": "line",
              "x": "actual_calendar_dte",
              "y": "eligible_dates"
            }
          ]
        },
        "notes": "Run-local chart of the entire eligible-date coverage distribution, not a fitted return CDF. Node artifact directories isolate tickers and runs; no static report paths."
      }
    }
  }
}
