{
  "notes": "Pooled zoo run (run-pooled-zoo-417.json), generated by index_options.pooled; never hand-edit. Run from children/index_options: python -m dskit.pipeline workflow configs/workflow-pooled-zoo-417.json (--only zoo, step7 or report to run one step). The study writes under experiment.output, which is the layout's {W}/study.",
  "args": {
    "work_dir": "./pipeline_runs/pooled-zoo-417",
    "run_env": {
      "notes": "Environment added to every command the runner starts (top-level env). CUBLAS_WORKSPACE_CONFIG is required by torch deterministic CUDA; the thread counts pin BLAS/OpenMP to one thread. A changed value reruns the steps.",
      "CUBLAS_WORKSPACE_CONFIG": ":4096:8",
      "OMP_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1"
    },
    "zoo": {
      "stages": {
        "sequence": [
          {
            "stage": "panel"
          },
          {
            "stage": "search",
            "partition": "*"
          },
          {
            "stage": "select"
          }
        ]
      },
      "notes": "The panel stage builds the panel cache in a process that fits nothing; then search every partition, then select."
    },
    "evaluate": {
      "stages": {
        "sequence": [
          {
            "stage": "evaluate",
            "partition": "development"
          },
          {
            "stage": "evaluate",
            "partition": "later"
          },
          {
            "stage": "report"
          }
        ]
      },
      "notes": "Step 6 already ran search and select, so step 7 starts at evaluate (select would refuse to overwrite the frozen selection). development = warm-up folds, later = scored folds only (frozen choices, holdout refused)."
    },
    "study_io": {
      "cli": {
        "flags": {
          "stage": "--stage",
          "partition": "--partition"
        },
        "expand": "partition",
        "wildcard": "*",
        "partitions_at": "experiment.search_partitions"
      }
    }
  },
  "env": "$args.run_env",
  "layout": {
    "zoo": {
      "dir": "{W}/workflow/zoo",
      "search": "{W}/study/search",
      "selection": "{W}/study/selection"
    },
    "step7": {
      "dir": "{W}/workflow/step7",
      "development": "{W}/study/evaluate/development",
      "scored": "{W}/study/evaluate/later",
      "report": "{W}/study/report"
    },
    "report": {
      "dir": "{W}/workflow/report",
      "output": "{W}/report",
      "markdown": "{L.report.output}/report.md",
      "html": "{L.report.output}/report.html",
      "sections": "{L.report.output}/sections"
    }
  },
  "registry": {
    "zoo": {
      "template": "run-pooled-zoo-417.json",
      "extends": null,
      "command": "{python} -m index_options.cdf_study {config}"
    },
    "step7": {
      "extends": "zoo"
    },
    "report": {
      "template": "templates/report-spec-pooled-zoo-417.json",
      "extends": null,
      "command": "{python} -m dskit.pipeline.workflow_report {config}"
    }
  },
  "steps": {
    "zoo": {
      "registry": "zoo",
      "in": {
        "W": "$args.work_dir"
      },
      "out": [
        "search",
        "selection"
      ],
      "stages": {
        "hook": "declared_sequence",
        "records": "$args.zoo.stages.sequence",
        "flags": "$args.study_io.cli.flags",
        "expand": "$args.study_io.cli.expand",
        "wildcard": "$args.study_io.cli.wildcard",
        "partitions_at": "$args.study_io.cli.partitions_at"
      }
    },
    "step7": {
      "registry": "step7",
      "in": {
        "W": "$args.work_dir"
      },
      "out": [
        "development",
        "scored",
        "report"
      ],
      "stages": {
        "hook": "declared_sequence",
        "records": "$args.evaluate.stages.sequence",
        "flags": "$args.study_io.cli.flags",
        "expand": "$args.study_io.cli.expand",
        "wildcard": "$args.study_io.cli.wildcard",
        "partitions_at": "$args.study_io.cli.partitions_at"
      }
    },
    "report": {
      "registry": "report",
      "in": {
        "W": "$args.work_dir",
        "selection": "$zoo.out.selection",
        "development": "$step7.out.development",
        "scored": "$step7.out.scored",
        "evaluation": "$step7.out.report"
      },
      "out": [
        "markdown",
        "html",
        "sections"
      ]
    }
  }
}
