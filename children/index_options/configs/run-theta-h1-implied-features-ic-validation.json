      "params": {
        "identity": [
          "symbol",
          "date"
        ],
        "agree_fields": [
          "agree"
        ],
        "max_absent_fraction": 0.3,
        "column_prefix": "ret5_",
        "families": {
          "ret5": {
            "fields": [
              "fwd5"
            ],
            "withheld_fields": {},
            "clock_note": "The 5-session forward return, known after the date."
          }
        }
      },
