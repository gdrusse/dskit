      },
      "notes": "The columns of ret5 the attachment demands: ['symbol', 'date'] + the agreed constant + ['fwd5'], nothing else."
    },
    "ret5": {
      "uses": "attach-by-identity",
      "inputs": {
        "records": "$features_agree.records",
        "table": "$ret5_table.records"
