            "outcome_field": "fwd5",
            "sign": -1
          }
        },
        "h_steps": 5,
        "splits": [
          "half"
        ],
        "family": {
          "alpha": 0.05,
          "corrections": [
            "bh",
            "bonferroni"
          ]
        }
