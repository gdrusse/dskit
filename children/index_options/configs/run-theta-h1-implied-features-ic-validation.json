    },
    "ic5": {
      "uses": "dskit.pipeline.kinds_stats:CrossSectionIC",
      "inputs": {
        "records": "$rows.records"
      },
      "params": {
        "stamp_field": "date",
        "series_field": "symbol",
        "measures": {
          "put_call_iv_spread": {
            "forecast_field": "put_call_iv_spread",
            "outcome_field": "fwd5",
            "sign": -1
          },
          "risk_reversal": {
            "forecast_field": "risk_reversal",
            "outcome_field": "fwd5",
            "sign": -1
          },
          "term_slope": {
            "forecast_field": "term_slope",
