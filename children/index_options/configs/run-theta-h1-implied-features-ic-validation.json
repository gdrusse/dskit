            "sign": -1
          }
        },
        "cost_per_side": 0.0005,
        "sides_per_leg": 2,
        "h_steps": 5,
        "bootstrap": {
          "block_days": 90,
          "replicates": 2000,
          "seed": 20261012,
          "level": 0.9
        },
        "splits": [
          "half"
        ]
      },
      "notes": "The decile long-short of each feature on the next-5-session return, long the declared-direction extreme decile, net of 10 bp round trip on EACH leg (cost_per_side 5 bp, two sides per leg: 20 bp for the book; the ADR's 10 bp round trip read as per leg, the stricter reading). Pass: net mean > 0 with Benjamini-Hochberg across the 6 features. Overlapping labels on daily stamps: h_steps = the horizon."
