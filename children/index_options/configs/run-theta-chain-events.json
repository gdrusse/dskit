   "params": {
    "symbol_field": "symbol",
    "date_field": "date",
    "target_field": "target_dte",
    "iv_field": "atm_iv",
    "straddle_field": "straddle_ratio",
    "spot_field": "spot",
    "status_field": "status",
    "status_ok": "ok",
    "front_target": 30,
    "back_target": 90,
    "end_before": "2021-01-01",
    "label_symbol_field": "symbol",
    "label_date_field": "earnings_date",
    "label_confidence_field": "confidence",
    "confidences": [
     "high"
    ],
    "labels_key": "labels",
    "fit_end_before": "2020-01-01",
    "match_before": 0,
    "match_after": 1,
    "grid": {
     "crush_min": [
      0.08,
      0.12,
      0.16
     ],
     "crush_z_min": [
      2,
      3,
      4
     ],
     "spread_drop_min": [
      0,
      0.01,
      0.02,
      0.04
     ]
    },
    "base": {
     "window": 60,
     "min_history": 20,
     "crush_min": 0.12,
     "crush_z_min": 3.0,
     "spread_drop_min": 0.01,
     "refractory": 50,
     "max_market_share": 0.4,
     "min_symbols_for_guard": 10,
     "max_gap_days": 5,
     "entry_lead": 3,
     "exit_lag": 1,
     "scale_floor": 0.01
    }
   },
   "notes": "Precision and recall of 36 threshold cells on the 16 AAPL announcements of 2016-2019; an event matches a label when it falls on the announcement date or one session later (announcements are after the close). The best_by_f1 cell is a reading aid, never applied."
  },
  "events_table": {
   "uses": "records-write",
   "inputs": {
    "records": "$events.records"
   },
   "params": {
    "path": "/home/russell/data/index_options/theta-research-20261012/chain-events/chain-events.jsonl",
    "overwrite": true,
    "source": "one row per labelled event: symbol, event_date, entry_date, exit_date, front and back ATM vol before and after, implied move (front straddle ratio before), realized close-to-close move, crush, crush z, spread drop"
   },
   "notes": "The event table the H2 documents attach by symbol and event_date. Labels for a retrospective backtest, not a signal."
  },
  "grid_table": {
   "uses": "records-write",
   "inputs": {
    "records": "$calibrate.records"
   },
   "params": {
    "path": "/home/russell/data/index_options/theta-research-20261012/chain-events/calibration-grid.jsonl",
    "overwrite": true,
    "source": "one row per threshold cell: events, matched, labels, precision, recall, f1"
   },
   "notes": "The calibration grid on 2016-2019 dates."
  },
  "counts": {
   "uses": "run-report",
   "inputs": {
    "edge": "$events.summary",
    "labelled": "$events_labelled.summary",
    "grid": "$calibrate.summary"
   },
   "params": {
    "title": "ThetaData chain events (ADR-0265 node 5)",
    "sections": [
     "stages"
    ]
   },
   "notes": "evidence.md renders the rule counters (missing data, rejected by each rule, market-wide, refractory, events) and the calibration counters."
  },
  "rates_raw": {
   "uses": "dskit.pipeline.libs.observations:ObservationRows",
   "params": {
    "root": "/home/russell/data/index_options/ob",
    "source": "fred-market-features",
    "stream": "dgs3mo",
    "key_fields": [
     "observation_date"
    ]
   },
   "notes": "The FRED 3-month constant-maturity Treasury yield (DGS3MO, percent, dated by the observation date, '.' on a holiday) from the index_options onboarding root, read-only. The series runs to 2026-09, so the node below drops 2026 before anything joins it."
  },
  "rates": {
   "uses": "filter",
   "inputs": {
    "records": "$rates_raw.records"
   },
   "params": {
    "where": [
     {
      "field": "observation_date",
      "op": "<",
      "value": "2021-01-01"
     },
     {
      "field": "DGS3MO",
      "op": "!=",
      "value": "."
     }
    ]
   },
   "notes": "Development years only: an observation dated 2021-01-01 or later never reaches the features node (which also refuses one), and a '.' (no print) is not a rate."
  },
  "events_labelled": {
   "uses": "dskit.pipeline.libs.chain_events:ChainEventDetector",
   "inputs": {
    "records": "$features.records",
    "labels": "$labels.table"
   },
   "params": {
    "symbol_field": "symbol",
    "date_field": "date",
    "target_field": "target_dte",
    "iv_field": "atm_iv",
    "straddle_field": "straddle_ratio",
    "spot_field": "spot",
    "status_field": "status",
    "status_ok": "ok",
    "front_target": 30,
    "back_target": 90,
    "end_before": "2021-01-01",
    "window": 60,
    "min_history": 20,
    "crush_min": 0.12,
    "crush_z_min": 3.0,
    "spread_drop_min": 0.01,
    "refractory": 50,
    "max_market_share": 0.4,
    "min_symbols_for_guard": 10,
    "max_gap_days": 5,
    "entry_lead": 3,
    "exit_lag": 1,
    "scale_floor": 0.01,
    "labelled_only": true,
    "label_symbol_field": "symbol",
    "label_date_field": "earnings_date",
    "label_confidence_field": "confidence",
    "confidences": [
     "high"
    ],
    "labels_key": "labels",
    "match_before": 0,
    "match_after": 1,
    "label_event_offset": 1
   },
   "notes": "The robustness set: ONE record per labelled announcement (event session = the session after the announcement, an after-the-close reporter), whatever the chain did, flagged detected when the rules accepted an event on the announcement session or the next. H2 must report its result on the detected events, on all labelled announcements, and the difference, with the coverage per year (summary.labelled_by_year)."
  },
  "labelled_table": {
   "uses": "records-write",
   "inputs": {
    "records": "$events_labelled.records"
   },
   "params": {
    "path": "/home/russell/data/index_options/theta-research-20261012/chain-events/chain-events-labelled.jsonl",
    "overwrite": true,
    "source": "one row per labelled announcement with a detected flag"
   },
   "notes": "The robustness set the H2 documents attach by symbol and event_date."
  }
 }
}
