        "source": "mio-2021q4-complete-inputs",
        "stream": "files",
        "key": "forecasts",
        "relpath_by_key": {
          "forecasts": "forecasts.parquet"
        },
        "columns": {
          "symbol": "symbol",
          "quote_date": "quote_date",
          "expiry": "expiry",
          "fold": "fold",
          "band": "band",
          "method_cdf_zm3": "method_cdf_zm3",
          "method_cdf_zm2.5": "method_cdf_zm2.5",
          "method_cdf_zm2": "method_cdf_zm2",
          "method_cdf_zm1.5": "method_cdf_zm1.5",
          "method_cdf_zm1": "method_cdf_zm1",
          "method_cdf_zm0.5": "method_cdf_zm0.5",
          "method_cdf_zp0": "method_cdf_zp0",
          "method_cdf_zp0.5": "method_cdf_zp0.5",
          "method_cdf_zp1": "method_cdf_zp1",
          "method_cdf_zp1.5": "method_cdf_zp1.5",
          "method_cdf_zp2": "method_cdf_zp2",
          "method_cdf_zp2.5": "method_cdf_zp2.5",
          "method_cdf_zp3": "method_cdf_zp3",
          "fitted": "fitted"
        }
      },
      "notes": "Existing prepared quarter source; original source pin and output values are verified and retained."
    },
    "forecasts_policy": {
      "uses": "derive",
      "inputs": {
        "records": "$forecasts_read.records"
      },
      "params": {
        "field": "eligibility_reason",
        "cases": [
          {
            "when": [
              {
                "field": "symbol",
                "op": "==",
                "value": "IBM"
              },
              {
                "field": "quote_date",
                "op": ">=",
                "value": "2021-10-13"
              },
              {
                "field": "quote_date",
                "op": "<",
                "value": "2021-11-05"
              },
              {
                "field": "expiry",
                "op": ">=",
                "value": "2021-11-03"
              }
            ],
            "value": "IBM_preannounced_Kyndryl_distribution"
          },
          {
            "when": [
              {
                "field": "symbol",
                "op": "==",
                "value": "O"
              },
              {
                "field": "quote_date",
                "op": ">=",
                "value": "2021-10-25"
              },
              {
                "field": "quote_date",
                "op": "<",
                "value": "2021-11-16"
              },
              {
                "field": "expiry",
                "op": ">=",
                "value": "2021-11-12"
              }
            ],
            "value": "O_preannounced_Orion_distribution"
          },
          {
            "value": "supported",
            "when": []
          }
        ]
      },
      "notes": "Only symbol, origin and expiry plus dated public notices. Identical predicates for both paired sources."
    },
    "forecasts_kept": {
      "uses": "filter",
      "inputs": {
        "records": "$forecasts_policy.records"
      },
      "params": {
        "where": [
          {
            "field": "eligibility_reason",
            "op": "==",
            "value": "supported"
          }
        ]
      }
    },
    "forecasts_kept_write": {
      "uses": "records-write",
      "inputs": {
        "records": "$forecasts_kept.records"
      },
      "params": {
        "path": "/home/russell/data/index_options/mio-2021h2-walkforward-20261101/coverage-v2/q4-eligibility-forecast-prep/forecasts-kept.jsonl",
        "source": "Approved public-notice eligibility kept; numerical values unchanged; original full chain retained"
      }
    },
    "forecasts_excluded": {
      "uses": "filter",
      "inputs": {
        "records": "$forecasts_policy.records"
      },
      "params": {
        "where": [
          {
            "field": "eligibility_reason",
            "op": "!=",
            "value": "supported"
          }
        ]
      }
    },
    "forecasts_excluded_write": {
      "uses": "records-write",
