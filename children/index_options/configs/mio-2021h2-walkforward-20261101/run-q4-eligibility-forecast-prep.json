{
  "name": "mio-q4-approved-spinoff-forecast-eligibility",
  "notes": "Owner-approved entry eligibility only. Full original chain/bars and daily basis remain intact. Apply exactly the same public-notice rule to paired prepared forecast/context rows. No forecast numerical values, fits, weights or outcomes used to select eligibility. Retain both accepted and excluded audit rows.",
  "outputs": {
    "run_root": "/home/russell/data/index_options/mio-2021h2-walkforward-20261101/coverage-v2/runs/q4-eligibility-forecast-prep"
  },
  "pipeline": {
