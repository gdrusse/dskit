{
  "name": "index-options-grid-spy-30-45-zoo",
  "notes": "ADR-0187 zoo over cell spy-30-45: the ADR-0182 rungs on one underlying and bucket, identical except 'model' (contract_paths pin everything else). Run from the child root: python -m dskit.pipeline staged configs/grid/spy-30-45-zoo.json --asof <today>. First run is plan-only: paste the printed inventory sha256 into approval, set approved_by, run again. Primary score is twCRPS (locked Path A0002); the backtest metrics ride along per fold as a sanity check, never a selection criterion. A candidate may carry no search node (ADR-0097): tune with the cell's hpo documents, pin the winner, then compare. Generated by index_options.grid.zoo_document; never edit this file.",
  "pipeline": {
    "market": {
      "uses": "index_options.observations:IndexCloseRows",
      "params": {
        "root": "./ob",
        "source": "optionshist-chain",
        "symbol": "SPY",
        "since_ms": 941414400000
      },
      "notes": "Structural node only; each candidate document owns its own pipeline."
    }
  },
  "stages": {
    "plan": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkPlan",
      "params": {
        "candidates": [
          {
            "id": "empirical",
            "group": "z21",
            "family": "empirical-location-scale",
            "representation": "tabular",
            "feature_policy": "no conditioning: train-split empirical z shape",
            "seed_policy": "fixed seed 0; deterministic fits",
            "compute_class": "cpu-small",
            "compute_rank": 1,
            "enabled": true,
            "path": "spy-30-45-empirical.json"
          },
          {
            "id": "vix",
            "group": "z21",
            "family": "log-iv-ols",
            "representation": "tabular",
            "feature_policy": "log iv_index, train-only OLS",
            "seed_policy": "fixed seed 0; deterministic fits",
            "compute_class": "cpu-small",
            "compute_rank": 1,
            "enabled": true,
            "path": "spy-30-45-vix.json"
          },
          {
            "id": "har-vix",
            "group": "z21",
            "family": "log-har-iv-ols",
            "representation": "tabular",
            "feature_policy": "log rv_1/rv_5/rv_22/iv_index, train-only OLS",
            "seed_policy": "fixed seed 0; deterministic fits",
            "compute_class": "cpu-small",
            "compute_rank": 1,
            "enabled": true,
            "path": "spy-30-45.json"
          },
          {
            "id": "lightgbm-vix",
            "group": "z21",
            "family": "lightgbm-scale-iv",
            "representation": "tabular",
            "feature_policy": "log rv_1/rv_5/rv_22/iv_index, shallow regularized booster fit on train",
            "seed_policy": "fixed seed 0; deterministic fits",
            "compute_class": "cpu-small",
            "compute_rank": 2,
            "enabled": true,
            "path": "spy-30-45-lightgbm-vix.json"
          }
        ],
        "contract_paths": [
          "pipeline.underlying",
          "pipeline.vix",
          "pipeline.vix_by_date",
          "pipeline.market",
          "pipeline.rv",
          "pipeline.labels",
          "pipeline.fwd",
          "pipeline.score",
          "pipeline.condor",
          "pipeline.chain",
          "pipeline.backtest",
          "pipeline.model.inputs",
          "pipeline.model.params.fit_split",
          "pipeline.model.params.label",
          "pipeline.model.params.scale_field",
          "pipeline.model.params.scale_multiplier",
          "pipeline.model.params.n_samples",
          "walkforward"
        ],
        "protocol": {
          "attempt_family": "index-options-grid-spy-30-45",
          "primary_score": "mean val threshold-weighted CRPS on |z| in [0.5, 2.5] (lower is better), locked Path A0002",
          "null_baseline": "empirical location-scale rung (R0a)",
          "cost_model": "equal fold weight; compute rank declared, not measured",
          "lockbox": "none held out: val folds run 2008-01-01 through the archive's end (2025-12); a forward lockbox is the recorded-chain period (ADR-0182)",
          "decision_rule": "report paired fold differences; prefer the simplest rung not detectably worse; never auto-promote",
          "alpha": 0.05,
          "comparison_hac_lags": 1,
          "multiplicity_method": "bonferroni_all_pairwise",
          "indifference_method": "paired_fold_newey_west_no_detectable_difference"
        }
      }
    },
    "approval": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkApproval",
      "inputs": {
        "inventory_sha256": "$plan.inventory_sha256"
      },
      "params": {
        "approved_inventory_sha256": "PENDING-PLAN-REVIEW",
        "approved_by": "PENDING-PLAN-REVIEW",
        "approval_note": "First invocation is plan-only. Review the frozen inventory, then replace both PENDING values before any candidate may fit."
      }
    },
    "run": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkRun",
      "inputs": {
        "candidates": "$plan.candidates",
        "approval": "$approval.approval"
      }
    },
    "compare": {
      "uses": "dskit.pipeline.benchmarks:BenchmarkCompare",
      "inputs": {
        "runs": "$run.runs",
        "protocol": "$plan.protocol",
        "contracts": "$plan.contracts",
        "approval": "$approval.approval"
      }
    }
  },
  "outputs": {
    "run_root": ""
  }
}
