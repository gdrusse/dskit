      "training": {
        "uses": "filter",
        "inputs": {
          "records": "$has_chain_nodes.records"
        },
        "params": {
          "where": [
            {
              "field": "has_implied_cdf",
              "op": ">=",
              "value": "$required_implied_cdf.table.all"
            },
            {
              "field": "has_return_history",
              "op": ">=",
              "value": "$required_return_history.table.all"
            },
            {
              "field": "has_realized_volatility",
              "op": ">=",
              "value": "$required_realized_volatility.table.all"
            },
            {
              "field": "has_ohlc_shape",
              "op": ">=",
              "value": "$required_ohlc_shape.table.all"
            },
            {
              "field": "has_volatility_context",
              "op": ">=",
              "value": "$required_volatility_context.table.all"
            },
            {
              "field": "has_expanded_volatility_context",
              "op": ">=",
              "value": "$required_expanded_volatility_context.table.all"
            },
            {
              "field": "has_surface_level",
              "op": ">=",
              "value": "$required_surface_level.table.all"
            },
            {
              "field": "has_surface_changes",
              "op": ">=",
              "value": "$required_surface_changes.table.all"
            },
            {
              "field": "has_variance_gap",
              "op": ">=",
              "value": "$required_variance_gap.table.all"
            },
            {
              "field": "has_liquidity",
              "op": ">=",
              "value": "$required_liquidity.table.all"
            },
            {
              "field": "has_positioning_changes",
              "op": ">=",
              "value": "$required_positioning_changes.table.all"
            },
            {
              "field": "has_macro_context",
              "op": ">=",
              "value": "$required_macro_context.table.all"
            },
            {
              "field": "has_chain_nodes",
              "op": ">=",
              "value": "$required_chain_nodes.table.all"
            }
          ]
        },
        "notes": "Complete-case dates: a dev date stays only when every ADMITTED family is available on it (has_f >= required_f: an admitted family must be 1, a rejected one may be 0 or 1). On the committed QQQ rows this leaves 1,096 dev dates; C4 needs train_n + (warmup_folds + 10) x step_n = 450 + 14 x 40 = 1,010 of them, plus the embargo-excluded dates. These dates SIZE and place the folds (the plan counts them); they are not written out and are not a training filter, because steps 4-6 slice by date range and median-impute the dates missing an admitted family. Owner decision 2026-10-02 (option A): median imputation is ACCEPTED and no complete-case filter will be built."
      },
      "plan": {
        "uses": "rolling-origin-plan",
        "inputs": {
          "records": "$training.records"
        },
        "params": {
          "date_field": "$columns.merged.date_field",
          "end_field": "$columns.merged.end_field",
          "holdout_start": "$cut.metrics.holdout_start",
          "embargo_days": "$dte.table.all",
          "train_n": 450,
          "val_n": 40,
          "step_n": 40,
          "warmup_folds": 4
        },
        "notes": "Count-sized rolling folds over the complete-case dates; all counts are DATES, not weeks. The fold windows are date boundaries that downstream cover ALL cohort dates between them: train_dates and val_dates count only complete-case dates, and the study median-imputes the rest (Owner decision 2026-10-02 (option A): median imputation is ACCEPTED and no complete-case filter will be built). holdout_start and embargo_days are wired (the cut's metric; step 1's selected DTE as carried by the rows), never typed. val_n = step_n = 40 dates (about a 9-week minimum window, C2 >= 8) and train_n 450 dates (min 107 weeks, C3 >= 100) give 16 folds on the committed QQQ rows (C1 needs >= 10 scored). warmup_folds is the smallest k meeting C5 (warm-up validation spans >= 52 ISO weeks, every season once) that still leaves C1; ADR-0222 swept these rows: k=3: 41 weeks, 13 scored (fails C5); k=4: 56 weeks over 160 dates, 12 scored; k=5: 70, 11; k=6: 80, 10; k>=7 fails C1. So warmup_folds 4. All selection (steps 4-6) runs on role == warmup only; scored folds are the clean evidence. The plan refuses a row on or past holdout_start and a label longer than the embargo, and a ticker with too few dates (AMZN, 90) yields no fold and refuses. PROVISIONAL: these values were derived on step 2's current rows and must be re-derived, not merely re-tested, when step 2 is rebuilt; SPY and IWM have not been swept."
      },
      "fold_table": {
        "uses": "derive",
        "inputs": {
          "records": "$plan.records"
        },
        "params": {
          "field": "symbol",
          "cases": [
            {
              "when": [],
              "value": "$each"
            }
          ]
        },
        "notes": "Stamps the ticker on each fold row so several tickers can share one file. The plan's own columns are untouched, so the rows are exactly what the node emits."
      },
      "protocol_holdout": {
        "uses": "derive",
        "inputs": {
          "records": "$admit_chain_nodes.records"
        },
        "params": {
          "field": "holdout",
          "cases": [
            {
              "when": [],
              "value": "$cut.metrics"
            }
          ]
        },
        "notes": "Attaches the holdout-cut metrics (dates and row counts only: holdout_start, holdout_end, holdout_dates, holdout_weeks, dev_dates, purged_rows, holdout_rows, panel_rows) to the admission row."
      },
      "protocol": {
        "uses": "derive",
        "inputs": {
          "records": "$protocol_holdout.records"
        },
        "params": {
          "field": "plan",
          "cases": [
            {
              "when": [],
              "value": "$plan.metrics"
            }
          ]
        },
        "notes": "Attaches the plan metrics (folds, scored, warmup_weeks, scored_start). The result is the single per-ticker row admission_evidence writes: the admitted families next to the two seams a consumer pins by value."
      }
    }
  }
