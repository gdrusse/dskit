          "event_source",
          "half"
        ],
        "bucket": "week",
        "h_steps": 1
      },
      "notes": "D3 primary in each original half, before ledger/trade filtering: mean > 0 and t >= 2.5 in both halves."
    },
    "gap_30d": {
