            "when": [],
            "value": "second"
          }
        ]
      },
      "notes": "The two halves of the period, split at 2023-07-01 (the same-sign-in-both-halves check)."
    },
    "gap_primary": {
      "uses": "dskit.pipeline.kinds_series:StampSeriesStats",
      "inputs": {
        "records": "$gap_phased.records"
      },
      "params": {
        "stamp_field": "event_date",
        "value_field": "event_gap",
        "by": [
          "event_source"
        ],
        "bucket": "week",
        "h_steps": 1,
        "bootstrap": {
          "block_days": 90,
          "replicates": 2000,
          "seed": 20261012,
          "level": 0.9
        }
      },
      "notes": "D3 PRIMARY: event-variance implied move minus realized move, by event source, clustered by event week. Pass: mean > 0 and t >= 2.5 in both frozen halves. The detected population and labelled robustness are reported separately; no pooled-source claim."
    },
    "gap_halves": {
