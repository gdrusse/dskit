        "renames_file": "configs/root-renames.json",
        "renames_key": "renames",
        "renames_sha256": "ddb611ae2675fcd083c74bfd0ef7c81f74c94828b5457782717116ccbbfe27c3",
        "breaks_key": "breaks",
        "pending_key": "pending_verification"
      },
      "notes": "The daily chain of the frozen universe, bounded to the period."
    },
    "ledger": {
      "uses": "dskit.pipeline.libs.option_ledger:OptionStructureLedger",
      "inputs": {
        "chain": "$chain.records",
        "orders": "$detected_orders.records"
      },
      "params": {
        "chain_fields": {
          "symbol": "symbol",
          "date": "date",
          "expiration": "expiration",
          "strike": "strike",
          "right": "right",
          "bid": "bid",
          "ask": "ask",
          "underlying": "underlying_price"
        },
        "order_fields": {
          "date": "open_date",
          "symbol": "symbol",
          "expiration": "expiration",
          "strikes": "strikes",
          "structure": "structure",
          "exit": "exit"
        },
        "structures": {
          "long_straddle_detected": [
            [
              "call",
              1
            ],
            [
              "put",
              1
            ]
          ]
        },
        "multiplier": 100,
        "fill": "nbbo",
        "close_rule": "exit"
      },
      "notes": "Buys both legs at the ASK on the entry session and sells at the BID on the exit session (an exit that cannot be quoted is counted and the trade runs to expiry, never a free exit)."
    },
    "closed": {
      "uses": "filter",
      "inputs": {
        "records": "$ledger.trades"
      },
      "params": {
        "where": [
          {
            "field": "status",
            "op": "==",
            "value": "closed"
          },
          {
            "field": "reason_closed",
            "op": "==",
            "value": "exit"
          }
        ]
      },
      "notes": "Trades that exited on the event+1 session at the NBBO; a trade that fell back to expiry is not the pre-registered holding and is excluded (counted in the ledger summary)."
    },
    "outcome_table": {
      "uses": "dskit.pipeline.kinds_compute:ComputeFields",
      "inputs": {
        "records": "$closed.records"
      },
      "params": {
        "fields": {
          "agree": {
            "const": 1
          }
        },
        "keep": [
          "symbol",
          "open_date",
          "structure",
          "pnl_over_premium"
        ]
      },
      "notes": "The columns of outcome the attachment demands: ['symbol', 'open_date', 'structure'] + the agreed constant + ['pnl_over_premium'], nothing else."
    },
    "outcome": {
      "uses": "attach-by-identity",
      "inputs": {
        "records": "$detected_orders.records",
        "table": "$outcome_table.records"
      },
      "params": {
        "identity": [
          "symbol",
          "open_date",
          "structure"
        ],
        "agree_fields": [
          "agree"
        ],
        "max_absent_fraction": 0.5,
        "column_prefix": "outcome_",
        "families": {
          "outcome": {
            "fields": [
              "pnl_over_premium"
            ],
            "withheld_fields": {},
            "clock_note": "The trade's return over its debit, NBBO both sides."
          }
        }
      },
      "notes": "The trade's return over its debit, NBBO both sides."
    },
    "scored": {
      "uses": "filter",
      "inputs": {
        "records": "$outcome.records"
      },
      "params": {
        "where": [
          {
            "field": "pnl_over_premium",
            "op": "!=",
            "value": null
          }
        ]
      },
      "notes": "Events with a closed trade."
    },
    "phased": {
      "uses": "derive",
      "inputs": {
        "records": "$scored.records"
      },
      "params": {
        "field": "half",
        "cases": [
          {
            "when": [
              {
                "field": "event_date",
                "op": "<",
                "value": "2023-07-01"
              }
            ],
            "value": "first"
          },
          {
            "when": [],
            "value": "second"
          }
        ]
      },
      "notes": "The two halves of the period, split at 2023-07-01 (the same-sign-in-both-halves check)."
    },
    "pnl": {
      "uses": "dskit.pipeline.kinds_series:StampSeriesStats",
      "inputs": {
        "records": "$phased.records"
      },
      "params": {
        "stamp_field": "event_date",
        "value_field": "pnl_over_premium",
        "by": [
          "event_source"
        ],
        "bucket": "week",
        "h_steps": 1,
        "bootstrap": {
          "block_days": 90,
          "replicates": 2000,
          "seed": 20261012,
          "level": 0.9
        }
      },
      "notes": "D4: H2(b) is measurement only. The ALL-labelled-dates robustness set (verified AAPL/high only) is the primary population; detected events and their unpaired difference are descriptive. A detected-only validation twin cannot pass or close H2(b). Event-week buckets and the original half split are unchanged."
    },
    "pnl_primary_rows": {
      "uses": "filter",
      "inputs": {
        "records": "$phased.records"
      },
      "params": {
        "where": [
          {
            "field": "event_source",
            "op": "==",
            "value": "labelled"
          }
        ]
      },
      "notes": "D4/D5: sole primary population for H2(b), all verified AAPL/high labelled announcements. Validation has none: detected-only cannot close H2(b)."
    },
    "pnl_primary": {
      "uses": "dskit.pipeline.kinds_series:StampSeriesStats",
      "inputs": {
        "records": "$pnl_primary_rows.records"
      },
      "params": {
        "stamp_field": "event_date",
        "value_field": "pnl_over_premium",
        "bucket": "week",
        "h_steps": 1,
        "bootstrap": {
          "block_days": 90,
          "replicates": 2000,
          "seed": 20261012,
          "level": 0.9
        }
      },
      "notes": "D4 PRIMARY POPULATION, measurement only: verified labelled-dates straddle returns, event-week buckets; no detected-only pass criterion."
    },
    "pnl_halves": {
      "uses": "dskit.pipeline.kinds_series:StampSeriesStats",
      "inputs": {
        "records": "$phased.records"
      },
      "params": {
        "stamp_field": "event_date",
        "value_field": "pnl_over_premium",
        "by": [
          "event_source",
          "half"
        ],
        "bucket": "week",
        "h_steps": 1
      },
      "notes": "The same by half of the period (same-sign check)."
    },
    "tercile_rows": {
      "uses": "filter",
      "inputs": {
        "records": "$phased.records"
      },
      "params": {
        "where": [
          {
            "field": "event_date",
            "op": ">=",
            "value": "2021-01-04"
          },
          {
            "field": "liquidity_tercile",
            "op": "!=",
            "value": null
          }
        ]
      },
      "notes": "D9: only the tercile-dependent reading starts in 2019; the overall and original half-period readings retain 2016-2020."
    },
    "pnl_terciles": {
      "uses": "dskit.pipeline.kinds_series:StampSeriesStats",
      "inputs": {
        "records": "$tercile_rows.records"
      },
      "params": {
        "stamp_field": "event_date",
        "value_field": "pnl_over_premium",
        "by": [
          "event_source",
          "liquidity_tercile"
        ],
        "bucket": "week",
        "h_steps": 1
      },
      "notes": "The same by liquidity tercile, frozen using 2016-2018 only (D9)."
    },
    "events_table": {
      "uses": "records-write",
      "inputs": {
        "records": "$gap_phased.records"
      },
      "params": {
        "path": "/home/russell/data/index_options/theta-research-20261012/hypotheses/h2-earnings-validation/events.jsonl",
        "overwrite": true,
        "source": "detected and labelled events: dates, source, realized source, event_gap, gap_30d and frozen half; before trade filtering"
      },
      "notes": "Audit rows, overwritten on a rerun: the run directory keeps the hashed record."
    },
    "report": {
      "uses": "run-report",
      "inputs": {
        "events": "$events.summary",
        "gap_source": "$gap_source.summary",
        "gap_primary": "$gap_primary.summary",
        "gap_halves": "$gap_halves.summary",
        "gap_30d": "$gap_30d.summary",
        "pnl": "$pnl.summary",
        "pnl_primary": "$pnl_primary.summary",
        "halves": "$pnl_halves.summary",
        "terciles": "$pnl_terciles.summary",
        "ledger": "$ledger.summary"
      },
      "params": {
        "title": "H2 earnings events: implied versus realized and the event straddle",
        "sections": [
          "stages"
        ]
      },
      "notes": "evidence.md renders the node summaries; evidence.json holds every value."
    }
  }
}
