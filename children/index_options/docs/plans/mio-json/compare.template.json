{
  "name": "mio-compare-one-packet",
  "notes": "Executable descriptive comparison template. Supply completed close_packet receipt references. No raw market data is read and no winner is chosen while the primary metric is undecided.",
  "pipeline": {
    "results": {
      "uses": "dskit.pipeline.study_protocol:StudyPacketResults",
      "params": {
        "study": "${study}",
        "result_receipts": "${result_receipts}"
      }
    },
    "comparison": {
      "uses": "index_options.ledger_studies:MIOPacketCompare",
      "inputs": {
        "results": "$results.results",
        "identities": "$results.identities"
      },
      "params": {
        "study": "${study}"
      }
    }
  },
  "outputs": {
    "run_root": "${output_root}"
  }
}
