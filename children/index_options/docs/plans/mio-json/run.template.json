{
  "name": "mio-run-one-packet",
  "notes": "Executable one-packet template. Substitute study, frozen_plan and claim_request from explicit StudyProtocolControl freeze. A development claim consumes already-exposed data; a fresh freeze requires a separately approved packet and admitted pair evidence.",
  "pipeline": {
    "open_packet": {
      "uses": "dskit.pipeline.study_protocol:StudyPacketOpen",
      "params": {
        "study": "${study}",
        "frozen_plan": "${frozen_plan}",
        "claim_request": "${claim_request}"
      }
    },
    "intake": {
      "uses": "index_options.observations:MIOPacketInputs",
      "inputs": {
        "permit": "$open_packet.permit"
      },
      "params": {
        "study": "${study}"
      }
    },
    "study": {
      "uses": "index_options.ledger_studies:MIOPacketStudy",
      "inputs": {
        "permit": "$open_packet.permit",
        "bounded_inputs": "$intake.bounded_inputs",
        "provenance": "$intake.provenance"
      },
      "params": {
        "study": "${study}"
      }
    },
    "close_packet": {
      "uses": "dskit.pipeline.study_protocol:StudyPacketClose",
      "inputs": {
        "permit": "$open_packet.permit",
        "results": "$study.results",
        "audit": "$study.audit",
        "provenance": "$intake.provenance"
      },
      "params": {
        "study": "${study}"
      }
    }
  },
  "outputs": {
    "run_root": "${output_root}"
  }
}
