        "overwrite": false,
        "source": "ADR-0271 structural skew_network.records; retrospective research, no trade or P&L"
      },
      "notes": "Immutable structural evidence for diagnostics and later paired replay."
    },
    "write_skew_baseline_rows": {
      "uses": "records-write",
      "inputs": {
        "records": "$skew_baseline.records"
      },
      "params": {
