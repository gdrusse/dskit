        "change_lags": [
          5
        ],
        "edges": {
          "precision": {
            "weight_field": "weight"
          },
          "correlation": {
            "weight_field": "weight"
          }
        }
      },
      "notes": "Labels y_h = spread h sessions later minus spread at t, known at that later close; edge weights are the yearly prior-only fits carried for the date (0 when the pair has no edge)."
