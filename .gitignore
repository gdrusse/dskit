# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtualenvs
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/

# Pipeline run outputs
pipeline_runs/

# Local tracking stores a document's mlflow sink writes beside them
mlruns.db
mlruns/

# OS / editor
.DS_Store
.idea/
.vscode/

# Secrets — the material never enters the repo
.env*
!.env.example


# Materialized read-only feature arrays generated by memory-bounded studies
children/*/pipeline_cache/
# Onboarding roots / asset stores created by child runs. Both spellings:
# a run creates the directory, and a worktree may SYMLINK one store into
# several checkouts — a trailing slash never matches the symlink.
children/*/ob
children/*/ob/
children/*/onboarding_root
children/*/onboarding_root/
children/*/runs/
children/*/asset_store/
children/*/decisions.jsonl

# The journal's writer lock (dskit/journal/base.py). Runtime state, one
# per child; the ledger it guards is what belongs in git.
.journal.lock

# Isolated agent worktrees the Claude Code harness creates in-repo — a
# working copy, never content to commit.
.claude/worktrees/
